            {
              "value": "all",
              "label": "Every menu item with a dropdown"
            },
            {
              "value": "1",
              "label": "1st menu item"
            },
            {
              "value": "2",
              "label": "2nd menu item"
            },
            {
              "value": "3",
              "label": "3rd menu item"
            },
            {
              "value": "4",
              "label": "4th menu item"
            },
            {
              "value": "5",
              "label": "5th menu item"
            },
            {
              "value": "6",
              "label": "6th menu item"
            },
            {
              "value": "7",
              "label": "7th menu item"
            },
            {
              "value": "8",
              "label": "8th menu item"
            },
            {
              "value": "name",
              "label": "Match by name (type below)"
            }
          ],
          "default": "2"
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item name",
          "info": "Exact name of the top menu item, like Shop. Keeps working if the menu order changes.",
          "default": "Shop",
          "visible_if": "{{ block.settings.menu_position == 'name' }}"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Fills the image, title and link when those are left empty."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Used when no collection is picked."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Without an image, the live store shows a product photo."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text",
          "info": "Leave empty to use the header's Image card button text."
        }
      ]
    }
  ]
}
{% endschema %}
