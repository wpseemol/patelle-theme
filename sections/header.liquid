{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="site-header-wrapper {% if template.name != 'index' %}header-inner-page{% endif %}" id="site-header">
  <div class="header-inner">
    <!-- Brand Logo -->
    <div class="header-logo-col">
      <a href="{{ routes.root_url }}" class="header-logo-link">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}" 
            alt="{{ section.settings.logo.alt | default: shop.name }}" 
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_height }}"
            style="width: {{ section.settings.logo_width }}px; height: {{ section.settings.logo_height }}px; object-fit: contain;"
            class="logo-image" 
            loading="eager"
          >
        {%- else -%}
          <div class="logo-fallback">
            <span class="logo-symbol">&#9776;</span>
            <span class="logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <!-- Dynamic Menu Navigation -->
    <nav class="header-nav-col">
      <div class="nav-glass-capsule">
        <ul class="nav-list">
          {%- assign main_menu = linklists[section.settings.menu] -%}
          {%- if main_menu != blank and main_menu.links.size > 0 -%}
            {%- for link in main_menu.links -%}
              <li class="nav-item {% if link.links.size > 0 %}has-dropdown{% endif %}">
                <a 
                  href="{{ link.url }}" 
                  class="nav-link {% if link.current or link.active or forloop.first and template.name == 'index' %}is-active{% endif %}"
                >
                  <span>{{ link.title }}</span>
                  {%- if link.links.size > 0 -%}
                    <svg class="chevron-down" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="1 1 5 5 9 1"></polyline>
                    </svg>
                  {%- endif -%}
                </a>

                {%- if link.links.size > 0 -%}
                  <ul class="nav-dropdown glass-card">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}" class="nav-dropdown-link">{{ childlink.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="nav-item"><a href="/" class="nav-link is-active"><span>Home</span></a></li>
            <li class="nav-item"><a href="/collections/all" class="nav-link"><span>Shop</span></a></li>
            <li class="nav-item"><a href="/collections" class="nav-link"><span>Collections</span></a></li>
          {%- endif -%}
        </ul>
      </div>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions-col">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="action-circle-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="action-circle-btn" aria-label="Cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-pill-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="action-circle-btn" aria-label="Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header Navigation",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "Logo Height"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Fallback Text",
      "default": "PATÉLLE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    }
  ]
}
{% endschema %}