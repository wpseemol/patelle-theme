{%- comment -%}
  PATÉLLE — Floating glass header
  The bar itself is transparent and floats over the hero: logo left, one
  frosted nav pill centred on the viewport mid-line, circular frost buttons on
  the right. Pill and buttons share the hero card's glass (rim light, bright
  top edge), and a glass lens slides under the links to the hovered item,
  resting on the current page. Full-width
  flyout panels blur the page behind them, the search panel is glass, and the
  mobile sheet's two-line icon morphs into a close mark.
  Behaviour: assets/patelle-header.js. Styles: assets/patelle-header.css.
  Setting ids from the previous header (logo, menu, show_*) are kept.
{%- endcomment -%}

{{ 'patelle-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'patelle-header.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Geist is the Figma typeface for the nav. It is only fetched when it is the
  selected font; otherwise the stack falls back to the system UI face.
{%- endcomment -%}
{%- if section.settings.nav_font == 'geist' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

{%- if settings.cart_type == 'notification' -%}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign s = section.settings
  assign main_menu = linklists[s.menu]
  assign search_menu = linklists[s.search_menu]

  # Prefer the header logo; fall back to Theme settings → Logo so the mark
  # still shows when the merchant only uploaded it in site settings.
  assign header_logo = s.logo
  if header_logo == blank
    assign header_logo = settings.logo
  endif

  assign logo_w = s.logo_width | default: 240
  assign logo_h = s.logo_max_height | default: 48
  if s.logo == blank and settings.logo != blank and settings.logo_width > logo_w
    assign logo_w = settings.logo_width
  endif

  case s.overlay_mode
    when 'home'
      if template.name == 'index'
        assign overlay = true
      else
        assign overlay = false
      endif
    when 'all'
      assign overlay = true
    else
      assign overlay = false
  endcase

  # Homepage: clear glass over the hero with the hero text colour.
  # Other overlay pages: light frost with the ink colour.
  assign overlay_ink = false
  assign on_hero = false
  assign glass_color = s.solid_glass_color
  assign text_color = s.solid_text_color
  if overlay
    if template.name == 'index'
      assign on_hero = true
      assign glass_color = s.overlay_glass_color
      assign text_color = s.overlay_text_color | default: s.solid_text_color
    else
      assign overlay_ink = true
    endif
  endif

  assign header_offset = s.capsule_top_gap | plus: s.bar_height

  case s.nav_font
    when 'geist'
      assign nav_family = "'Geist', -apple-system, BlinkMacSystemFont, sans-serif"
    when 'inter'
      assign nav_family = 'var(--pt-font)'
    when 'body'
      assign nav_family = 'var(--font-body-family)'
    when 'heading'
      assign nav_family = 'var(--font-heading-family)'
    else
      assign nav_family = "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'Inter', Arial, sans-serif"
  endcase

  assign menu_label = 'sections.header.menu' | t
  assign search_label = 'general.search.search' | t
  assign close_label = 'accessibility.close' | t
  assign cart_label = 'templates.cart.cart' | t
  assign account_label = 'customer.account.title' | t
  assign login_label = 'customer.log_in' | t
-%}

{% style %}
  :root {
    --pt-header-overlay-h: {% if overlay %}{{ header_offset }}px{% else %}0px{% endif %};
  }

  #PtHeader {
    --ph-bar-h: {{ s.bar_height }}px;
    --ph-bar-radius: {{ s.bar_radius | default: 32 }}px;
    --ph-max: {% if s.match_page_width %}{{ s.side_padding | default: 40 | times: 2 | plus: settings.page_width }}{% else %}{{ s.max_width }}{% endif %}px;
    --ph-gap-top: {{ s.capsule_top_gap }}px;
    --ph-pad-x: {{ s.side_padding | default: 40 }}px;
    --ph-glass: {{ glass_color.red }}, {{ glass_color.green }}, {{ glass_color.blue }};
    --ph-glass-alpha: {{ s.glass_opacity | divided_by: 100.0 }};
    --ph-blur: {{ s.glass_blur }}px;
    --ph-saturate: {{ s.glass_saturation }}%;
    --ph-border-alpha: {{ s.border_opacity | divided_by: 100.0 }};
    --ph-text: {{ text_color }};
    --ph-nav-ink: {{ text_color }};
    --ph-accent: {{ s.accent_color }};
    --ph-scrim: {{ s.scrim_color.red }}, {{ s.scrim_color.green }}, {{ s.scrim_color.blue }};
    --ph-scrim-alpha: {{ s.scrim_opacity | divided_by: 100.0 }};
    --ph-scrim-blur: {{ s.scrim_blur }}px;
    --ph-font: {{ nav_family }};
    --ph-font-size: {{ s.nav_font_size }}px;
    --ph-font-weight: {{ s.nav_font_weight }};
    --ph-flyout-size: {{ s.flyout_font_size }}px;
    --ph-logo-h: {{ logo_h }}px;
    --ph-logo-w: {{ logo_w }}px;
    --ph-speed: {{ s.animation_speed }}ms;
  }

  {%- if overlay_ink %}
    /* Sections that run under the glass add the offset themselves (pt-under-header). */
    #MainContent:not(:has(.pt-under-header)) {
      padding-top: {{ header_offset }}px;
    }
  {%- endif %}

  {%- if on_hero %}
    #PtHeader.is-past-hero {
      --ph-text: {{ s.solid_text_color }};
      --ph-nav-ink: {{ s.solid_text_color }};
    }
  {%- endif %}
{% endstyle %}

<pt-header
  id="PtHeader"
  class="pt-header pt-header--{{ s.header_style }} pt-header--align-{{ s.menu_alignment }} pt-header--active-{{ s.active_style }}{% if overlay %} pt-header--overlay{% else %} pt-header--solid{% endif %}{% if overlay_ink %} pt-header--overlay-ink{% endif %}{% if s.bar_glass %} pt-header--glass-bar{% endif %}{% if on_hero %} pt-header--hero{% endif %}{% if s.invert_logo and overlay and overlay_ink == false and s.logo_lockup != 'figma' and header_logo != blank %} pt-header--invert-logo{% endif %}"
  data-sticky="{{ s.sticky_mode }}"
  data-flyouts="{{ s.enable_flyouts }}"
  data-blur-page="{{ s.blur_page }}"
  data-search-style="{{ s.search_style }}"
  data-lens="{{ s.enable_lens }}"
  {% if on_hero %}data-hero-offset="{{ header_offset }}"{% endif %}
>
  <div class="pt-header__scrim" data-scrim aria-hidden="true"></div>

  <div class="pt-header__shell" data-shell>
    <div class="pt-header__frame">
      <div class="pt-header__bg" data-bg aria-hidden="true"></div>

      <div class="pt-header__bar">
        <a href="{{ routes.root_url }}" class="pt-header__logo" aria-label="{{ shop.name | escape }}">
          {%- comment -%}
            sizes must track the Logo max width setting, otherwise the browser
            under-picks from the srcset and the mark renders soft. Figma lockup
            mode draws the monogram + wordmark + tagline in type when chosen
            (or when no image is uploaded).
          {%- endcomment -%}
          {%- assign logo_size = logo_w | append: 'px' -%}
          {%- render 'patelle-logo-lockup',
            logo_image: header_logo,
            logo_text: s.logo_text,
            logo_tagline: s.logo_tagline,
            logo_alt: shop.name,
            widths: '200, 400, 600, 800',
            sizes: logo_size,
            lockup_mode: s.logo_lockup
          -%}
        </a>

        <nav class="pt-header__nav" aria-label="{{ menu_label | escape }}">
          <ul class="pt-header__menu" role="list">
            {%- if main_menu != blank and main_menu.links.size > 0 -%}
              {%- for link in main_menu.links -%}
                {%- liquid
                  assign has_children = false
                  if link.links.size > 0 and s.enable_flyouts
                    assign has_children = true
                  endif
                -%}
                <li class="pt-header__item" {% if has_children %}data-flyout-item="{{ forloop.index }}"{% endif %}>
                  <a
                    href="{{ link.url }}"
                    class="pt-header__link"
                    {% if link.current or link.child_current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                  {%- if has_children -%}
                    <button
                      type="button"
                      class="pt-header__disclose"
                      aria-expanded="false"
                      aria-controls="PtFlyout-{{ forloop.index }}"
                      data-flyout-toggle="{{ forloop.index }}"
                    >
                      <span class="visually-hidden">{{ link.title | escape }}</span>
                      <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- elsif request.design_mode -%}
              <li class="pt-header__item"><span class="pt-header__link">Choose a menu in the header settings</span></li>
            {%- endif -%}
          </ul>
        </nav>

        <div class="pt-header__actions">
          {%- if s.show_search -%}
            {%- if s.search_style == 'hover' -%}
              <div class="pt-header__seek" data-seek>
                <form action="{{ routes.search_url }}" method="get" role="search" class="pt-header__icon pt-header__seek-form">
                  <label class="visually-hidden" for="PtHeaderSeek">{{ search_label }}</label>
                  <input
                    id="PtHeaderSeek"
                    class="pt-header__seek-input"
                    type="search"
                    name="q"
                    autocomplete="off"
                    placeholder="{{ s.search_placeholder | escape }}"
                    aria-controls="PtSearchResults"
                    data-seek-input
                  >
                  <input type="hidden" name="options[prefix]" value="last">
                  <button type="submit" class="pt-header__seek-btn" aria-controls="PtFlyout-search" aria-expanded="false" data-seek-button>
                    <span class="visually-hidden">{{ search_label }}</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.8 15.8L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </button>
                </form>
              </div>
            {%- elsif s.search_style == 'flyout' -%}
              <button
                type="button"
                class="pt-header__icon"
                aria-expanded="false"
                aria-controls="PtFlyout-search"
                data-flyout-toggle="search"
              >
                <span class="visually-hidden">{{ search_label }}</span>
                <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.8 15.8L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </button>
            {%- else -%}
              <a href="{{ routes.search_url }}" class="pt-header__icon">
                <span class="visually-hidden">{{ search_label }}</span>
                <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.8 15.8L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </a>
            {%- endif -%}
          {%- endif -%}

          {%- comment -%} Reference order: search, bag, profile. {%- endcomment -%}
          {%- if s.show_cart -%}
            <div class="pt-header__cart"{% if s.cart_preview %} data-minicart{% endif %}>
              <a href="{{ routes.cart_url }}" class="pt-header__icon pt-header__icon--cart" data-cart-link>
                <span class="visually-hidden">{{ cart_label }}</span>
                <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 12.2a1 1 0 0 1-1 .8H7a1 1 0 0 1-1-.8L5 8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                <span class="pt-header__count" data-cart-count aria-hidden="true" {% if cart.item_count == 0 %}hidden{% endif %}>
                  {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
                </span>
                <span
                  class="visually-hidden"
                  data-cart-count-label
                  data-one="{{ 'sections.header.cart_count' | t: count: 1 | escape }}"
                  data-other="{{ 'sections.header.cart_count' | t: count: 2 | escape }}"
                >
                  {{- 'sections.header.cart_count' | t: count: cart.item_count -}}
                </span>
              </a>
              {%- if s.cart_preview -%}
                <div
                  class="pt-minicart pt-popup-glass"
                  id="PtMiniCart"
                  role="region"
                  aria-label="{{ 'sections.cart.title' | t | escape }}"
                  data-minicart-panel
                  data-money-format="{% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | strip_html | escape }}{% else %}{{ shop.money_format | strip_html | escape }}{% endif %}"
                  data-cart-url="{{ routes.cart_url }}"
                  data-shop-url="{{ routes.all_products_collection_url }}"
                  data-title="{{ 'sections.cart.title' | t | escape }}"
                  data-empty="{{ 'sections.cart.empty' | t | escape }}"
                  data-count-one="{{ 'sections.header.cart_count' | t: count: 1 | escape }}"
                  data-count-other="{{ 'sections.header.cart_count' | t: count: 2 | escape }}"
                  data-total="{{ 'sections.cart.estimated_total' | t | escape }}"
                  data-view="{{ 'general.cart.view_empty_cart' | t | escape }}"
                  data-checkout="{{ 'sections.cart.checkout' | t | escape }}"
                  data-shop="{{ 'general.continue_shopping' | t | escape }}"
                  data-qty="{{ 'products.product.quantity.label' | t | escape }}"
                >
                  <div class="pt-minicart__skeleton"></div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if s.show_account and shop.customer_accounts_enabled -%}
            <a href="{{ routes.account_url }}" class="pt-header__icon pt-header__icon--account">
              <span class="visually-hidden">{% if customer %}{{ account_label }}{% else %}{{ login_label }}{% endif %}</span>
              <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </a>
          {%- endif -%}

          <button
            type="button"
            class="pt-header__icon pt-header__toggle"
            aria-expanded="false"
            aria-controls="PtHeaderSheet"
            data-sheet-toggle
          >
            <span class="visually-hidden" data-toggle-label data-open="{{ menu_label | escape }}" data-close="{{ close_label | escape }}">{{ menu_label }}</span>
            <span class="pt-header__lines" aria-hidden="true"><span></span><span></span></span>
          </button>
        </div>
      </div>

      {%- comment -%} Desktop flyouts {%- endcomment -%}
      <div class="pt-header__flyouts" data-flyouts-wrap>
        {%- if s.enable_flyouts -%}
          {%- for link in main_menu.links -%}
            {%- if link.links.size > 0 -%}
              {%- liquid
                # Cards come from "Menu image card" blocks set to this menu
                # item's position (or name, or every dropdown). Without blocks,
                # collection and product links in the submenu supply their
                # featured images.
                assign item_key = link.title | downcase | strip
                assign menu_index = forloop.index | append: ''
                assign card_count = 0
                assign card_start = link.links.size | plus: 1
              -%}
              {%- capture flyout_cards -%}
                {%- if s.flyout_style == 'images' -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign card_target = block.settings.menu_position | default: 'name'
                      if card_target == 'name'
                        assign card_key = block.settings.menu_item | downcase | strip
                        if card_key != item_key and card_key != link.handle
                          continue
                        endif
                      elsif card_target != 'all' and card_target != menu_index
                        continue
                      endif
                      if card_count >= s.flyout_card_limit
                        break
                      endif
                      assign card_count = card_count | plus: 1
                      assign card_index = card_start | plus: card_count

                      # Empty fields fall back to the picked collection, then the picked product.
                      assign card_collection = block.settings.collection
                      assign card_product = block.settings.product
                      assign card_image = block.settings.image
                      if card_image == blank
                        assign card_image = card_collection.featured_image | default: card_product.featured_image
                      endif
                      if card_image == blank and request.design_mode == false
                        assign fallback_offset = card_count | minus: 1
                        for fallback in collections.all.products offset: fallback_offset limit: 1
                          assign card_image = fallback.featured_image
                        endfor
                      endif
                      assign card_heading = block.settings.heading | default: card_collection.title | default: card_product.title
                      assign card_url = block.settings.link | default: card_collection.url | default: card_product.url
                      assign card_label = block.settings.cta | default: s.flyout_card_cta
                    -%}
                    {%- render 'patelle-header-card',
                      image: card_image,
                      heading: card_heading,
                      label: card_label,
                      url: card_url,
                      index: card_index,
                      attributes: block.shopify_attributes
                    -%}
                  {%- endfor -%}

                  {%- if card_count == 0 -%}
                    {%- for child in link.links -%}
                      {%- liquid
                        if child.type != 'collection_link' and child.type != 'product_link'
                          continue
                        endif
                        if child.object.featured_image == blank
                          continue
                        endif
                        if card_count >= s.flyout_card_limit
                          break
                        endif
                        assign card_count = card_count | plus: 1
                        assign card_index = card_start | plus: card_count
                      -%}
                      {%- render 'patelle-header-card',
                        image: child.object.featured_image,
                        heading: child.title,
                        label: s.flyout_card_cta,
                        url: child.url,
                        index: card_index
                      -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endcapture -%}

              <div class="pt-header__flyout{% if card_count > 0 %} pt-header__flyout--images{% endif %}" id="PtFlyout-{{ forloop.index }}" data-flyout="{{ forloop.index }}" aria-hidden="true" inert>
                <div class="pt-header__flyout-inner">
                  <div class="pt-header__col pt-header__col--primary">
                    <p class="pt-header__col-title">{{ s.flyout_prefix | append: ' ' | append: link.title | strip | escape }}</p>
                    <ul role="list">
                      {%- for child in link.links -%}
                        <li style="--i: {{ forloop.index }}">
                          <a href="{{ child.url }}" class="pt-header__flyout-link pt-header__flyout-link--lg" {% if child.current %}aria-current="page"{% endif %}>
                            {{- child.title | escape -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- assign col_index = 0 -%}
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      {%- assign col_index = col_index | plus: 1 -%}
                      <div class="pt-header__col">
                        <p class="pt-header__col-title">{{ child.title | escape }}</p>
                        <ul role="list">
                          {%- for grandchild in child.links -%}
                            <li style="--i: {{ forloop.index | plus: col_index }}">
                              <a href="{{ grandchild.url }}" class="pt-header__flyout-link" {% if grandchild.current %}aria-current="page"{% endif %}>
                                {{- grandchild.title | escape -}}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if card_count > 0 -%}
                    <ul class="pt-header__cards" role="list" style="--ph-cards: {{ card_count }}">
                      {{- flyout_cards -}}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if s.show_search and s.search_style != 'page' -%}
          <div class="pt-header__flyout pt-header__flyout--search" id="PtFlyout-search" data-flyout="search" aria-hidden="true" inert>
            <div class="pt-header__flyout-inner">
              <form action="{{ routes.search_url }}" method="get" role="search" class="pt-header__search">
                <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.8 15.8L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                <label class="visually-hidden" for="PtHeaderSearch">{{ search_label }}</label>
                <input
                  id="PtHeaderSearch"
                  class="pt-header__search-input"
                  type="search"
                  name="q"
                  autocomplete="off"
                  placeholder="{{ s.search_placeholder | escape }}"
                  aria-controls="PtSearchResults"
                  data-search-input
                >
                <input type="hidden" name="options[prefix]" value="last">
              </form>
              <div
                class="pt-header__results"
                id="PtSearchResults"
                role="region"
                aria-label="{{ 'templates.search.title' | t | escape }}"
                data-search-results
                data-url="{{ routes.predictive_search_url }}.json"
                data-search-url="{{ routes.search_url }}"
                data-live="{{ settings.predictive_search_enabled }}"
                data-show-price="{{ settings.predictive_search_show_price }}"
                data-show-vendor="{{ settings.predictive_search_show_vendor }}"
                data-money-format="{% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | strip_html | escape }}{% else %}{{ shop.money_format | strip_html | escape }}{% endif %}"
                data-products="{{ 'templates.search.products' | t | escape }}"
                data-suggestions="{{ 'templates.search.suggestions' | t | escape }}"
                data-empty="{{ 'templates.search.no_results' | t: terms: '__TERMS__' | escape }}"
                data-view-all="{{ 'templates.search.search_for' | t: terms: '__TERMS__' | escape }}"
                hidden
              ></div>
              {%- if search_menu != blank and search_menu.links.size > 0 -%}
                <div class="pt-header__col" data-search-links>
                  <p class="pt-header__col-title">{{ s.search_links_title | escape }}</p>
                  <ul role="list">
                    {%- for link in search_menu.links -%}
                      <li style="--i: {{ forloop.index }}">
                        <a href="{{ link.url }}" class="pt-header__flyout-link pt-header__flyout-link--arrow">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if settings.cart_type == 'notification' -%}
        {%- render 'cart-notification', desktop_menu_type: 'dropdown', color_scheme: s.notification_color_scheme -%}
      {%- endif -%}
      {%- comment -%} Dawn's cart scripts refresh an element with this id after an add. {%- endcomment -%}
      <span id="cart-icon-bubble" hidden></span>
    </div>
  </div>

  {%- comment -%} Mobile sheet {%- endcomment -%}
  <div class="pt-header__sheet" id="PtHeaderSheet" data-sheet aria-hidden="true" inert>
    <div class="pt-header__sheet-track">
      <div class="pt-header__panel is-current" data-panel="root">
        <ul role="list">
          {%- for link in main_menu.links -%}
            <li style="--i: {{ forloop.index }}">
              {%- if link.links.size > 0 -%}
                <button type="button" class="pt-header__sheet-link" data-drill="{{ forloop.index }}" aria-controls="PtPanel-{{ forloop.index }}" aria-expanded="false">
                  <span>{{ link.title | escape }}</span>
                  <svg width="9" height="15" viewBox="0 0 9 15" aria-hidden="true" focusable="false"><path d="M1.5 1.5l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              {%- else -%}
                <a href="{{ link.url }}" class="pt-header__sheet-link" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if s.show_account and shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="pt-header__sheet-meta" style="--i: {{ main_menu.links.size | plus: 1 }}">
            {%- if customer -%}{{ account_label }}{%- else -%}{{ login_label }}{%- endif -%}
          </a>
        {%- endif -%}
      </div>

      {%- for link in main_menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="pt-header__panel" id="PtPanel-{{ forloop.index }}" data-panel="{{ forloop.index }}" aria-hidden="true" inert>
            <button type="button" class="pt-header__back" data-back>
              <svg width="9" height="15" viewBox="0 0 9 15" aria-hidden="true" focusable="false"><path d="M7.5 1.5l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="visually-hidden">{{ menu_label }}</span>
            </button>
            <p class="pt-header__col-title" style="--i: 1">{{ link.title | escape }}</p>
            <ul role="list">
              {%- for child in link.links -%}
                <li style="--i: {{ forloop.index | plus: 1 }}">
                  <a href="{{ child.url }}" class="pt-header__sheet-link">{{ child.title | escape }}</a>
                  {%- if child.links.size > 0 -%}
                    <ul role="list" class="pt-header__sheet-sub">
                      {%- for grandchild in child.links -%}
                        <li><a href="{{ grandchild.url }}" class="pt-header__sheet-meta">{{ grandchild.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</pt-header>

{% schema %}
{
  "name": "Glass header",
  "class": "section-pt-header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use Theme settings → Logo."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "info": "Used by the Figma lockup (and when there's no logo image).",
      "default": "PATÉLLE"
    },
    {
      "type": "text",
      "id": "logo_tagline",
      "label": "Logo tagline",
      "info": "Figma lockup only — sits under the wordmark.",
      "default": "Luxury No Makeup"
    },
    {
      "type": "select",
      "id": "logo_lockup",
      "label": "Logo style",
      "options": [
        {
          "value": "image",
          "label": "Uploaded image"
        },
        {
          "value": "figma",
          "label": "Figma lockup (mark + type + tagline)"
        }
      ],
      "default": "figma",
      "info": "Figma lockup always shows the monogram, wordmark, and tagline in the header type color."
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo height",
      "info": "Scales the Figma lockup and uploaded logo. Theme settings → Logo is used when this section has no image.",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo max width",
      "min": 100,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "checkbox",
      "id": "invert_logo",
      "label": "Show logo image in white over the hero",
      "info": "For dark uploaded logos. The Figma lockup already follows the header text color.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_style",
      "label": "Style",
      "options": [
        {
          "value": "bar",
          "label": "Glass bar (Apple)"
        },
        {
          "value": "capsule",
          "label": "Floating glass capsule"
        }
      ],
      "default": "bar"
    },
    {
      "type": "checkbox",
      "id": "bar_glass",
      "label": "Glass background behind the bar",
      "info": "A clear, curved glass panel behind the logo, menu and icons.",
      "default": true
    },
    {
      "type": "range",
      "id": "bar_radius",
      "label": "Glass background curve",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 48,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "capsule_top_gap",
      "label": "Distance from the top",
      "info": "Figma puts the bar 36px below the top of the page.",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Left / right padding",
      "info": "Space from the viewport edge to the logo and icons.",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "match_page_width",
      "label": "Match page width",
      "info": "Lines the logo and icons up with the page content. Change it in Theme settings → Layout → Page width.",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440,
      "visible_if": "{{ section.settings.match_page_width == false }}"
    },
    {
      "type": "select",
      "id": "menu_alignment",
      "label": "Menu position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "After logo"
        },
        {
          "value": "right",
          "label": "Before icons"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "overlay_mode",
      "label": "Sit on top of the page",
      "info": "An overlaid header lets the hero run under the glass.",
      "options": [
        {
          "value": "home",
          "label": "Homepage only"
        },
        {
          "value": "all",
          "label": "All pages"
        },
        {
          "value": "none",
          "label": "Never"
        }
      ],
      "default": "home"
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "When scrolling",
      "options": [
        {
          "value": "always",
          "label": "Stay visible"
        },
        {
          "value": "reveal",
          "label": "Hide going down, show going up"
        },
        {
          "value": "none",
          "label": "Scroll away"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "header",
      "content": "Glass"
    },
    {
      "type": "color",
      "id": "overlay_glass_color",
      "label": "Glass tint over the hero",
      "default": "#ffffff",
      "info": "Homepage uses a clear magnifying-glass frost; keep this light so the hero shows through."
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Text over the hero",
      "info": "Homepage logo, menu links and icons.",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "solid_glass_color",
      "label": "Glass tint on other pages",
      "default": "#fbfbfd"
    },
    {
      "type": "color",
      "id": "solid_text_color",
      "label": "Text and icon color",
      "default": "#111111",
      "info": "Logo, menu links and icons on every page except the homepage."
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass opacity",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 22
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Blur",
      "info": "Frost on the nav pill, icon buttons, open panels, and mobile sheet — like iOS liquid glass.",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "glass_saturation",
      "label": "Color saturation behind glass",
      "min": 100,
      "max": 220,
      "step": 10,
      "unit": "%",
      "default": 200
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Edge highlight",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "%",
      "default": 36
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "nav_font",
      "label": "Font",
      "options": [
        {
          "value": "geist",
          "label": "Geist (Figma)"
        },
        {
          "value": "apple",
          "label": "SF Pro (Apple system)"
        },
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        }
      ],
      "default": "geist"
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "Text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "active_style",
      "label": "Current page marker",
      "options": [
        {
          "value": "dim",
          "label": "Dim other links"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "pill",
          "label": "Glass pill"
        }
      ],
      "default": "pill"
    },
    {
      "type": "checkbox",
      "id": "enable_lens",
      "label": "Sliding glass lens on hover",
      "info": "A glass highlight glides under the links and rests on the current page. Replaces the static pill marker while it runs.",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cart count and marker color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Dropdown panels"
    },
    {
      "type": "checkbox",
      "id": "enable_flyouts",
      "label": "Open submenus as full-width glass panels",
      "default": true
    },
    {
      "type": "select",
      "id": "flyout_style",
      "label": "Panel design",
      "options": [
        {
          "value": "images",
          "label": "Links with image cards"
        },
        {
          "value": "classic",
          "label": "Links only"
        }
      ],
      "default": "images",
      "info": "Add, remove or reorder cards with the Menu image card blocks under Header. Without blocks, collection and product links show their featured images."
    },
    {
      "type": "range",
      "id": "flyout_card_limit",
      "label": "Image cards per panel",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "flyout_card_cta",
      "label": "Image card button text",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "flyout_prefix",
      "label": "Panel title prefix",
      "info": "Appears before the menu item name, like 'Explore Women'.",
      "default": "Explore"
    },
    {
      "type": "range",
      "id": "flyout_font_size",
      "label": "Panel link size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "blur_page",
      "label": "Blur the page behind open panels",
      "default": true
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Page dim color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Page dim",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "scrim_blur",
      "label": "Page blur",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Open and close speed",
      "min": 80,
      "max": 800,
      "step": 20,
      "unit": "ms",
      "default": 160
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "select",
      "id": "search_style",
      "label": "Search opens",
      "options": [
        {
          "value": "hover",
          "label": "Expanding field on hover"
        },
        {
          "value": "flyout",
          "label": "Glass panel on click"
        },
        {
          "value": "page",
          "label": "Search page"
        }
      ],
      "default": "hover",
      "info": "Expanding field: live results open in a glass panel below. Phones and tablets always use the glass panel."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search fragrances"
    },
    {
      "type": "link_list",
      "id": "search_menu",
      "label": "Quick links in search panel"
    },
    {
      "type": "text",
      "id": "search_links_title",
      "label": "Quick links title",
      "default": "Quick links"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cart_preview",
