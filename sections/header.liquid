  "blocks": [
    {
      "type": "menu_card",
      "name": "Menu image card",
      "limit": 16,
      "settings": [
        {
          "type": "select",
          "id": "menu_position",
          "label": "Show under menu item",
          "info": "Count the main menu from the left, Home included. Only items with a dropdown show cards.",
