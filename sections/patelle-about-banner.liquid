{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-brand-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_about = false
  if page.handle == 'about' or template.suffix == 'about'
    assign show_about = true
  endif
-%}

{%- if show_about -%}
  {%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom, mode: section.settings.spacing_mode -%}
  <section
    class="pt-section pt-brand"
    style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
  >
    <div class="pt-wrap">
      <div class="pt-brand__banner" style="--pt-brand-bg:{{ section.settings.background }};">
        {%- if section.settings.image != blank -%}
          <img
            class="pt-brand__bg"
            src="{{ section.settings.image | image_url: width: 2880 }}"
            srcset="
              {{ section.settings.image | image_url: width: 1440 }} 1440w,
              {{ section.settings.image | image_url: width: 2160 }} 2160w,
              {{ section.settings.image | image_url: width: 2880 }} 2880w
            "
            sizes="100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- endif -%}

        <div class="pt-brand__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="pt-brand__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="pt-brand__text">{{ section.settings.text }}</p>
          {%- endif -%}

          {%- if section.settings.link_label != blank -%}
            <a class="pt-brand__link" href="{{ section.settings.link | default: '#' }}">
              {{ section.settings.link_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PATÉLLE — About banner",
  "tag": "section",
  "class": "section-patelle-about-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fallback background",
      "default": "#7FA0C4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The perfume house for the next generation®"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Premium-quality French fragrances. No excessive markups. Crafted with heart, not ego."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "presets": [{ "name": "PATÉLLE — About banner" }]
}
{% endschema %}
