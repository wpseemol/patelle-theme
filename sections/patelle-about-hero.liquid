{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_about = false
  if page.handle == 'about' or template.suffix == 'about'
    assign show_about = true
  endif
-%}

{%- if show_about -%}
  {%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom, mode: section.settings.spacing_mode -%}
  <section
    class="pt-section pt-about-page pt-about-hero pt-under-header"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pt-wrap">
      <div class="pt-about-hero__intro">
        {%- if section.settings.heading != blank -%}
          <h1 class="pt-about-hero__title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="pt-about-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="pt-about-hero__fan" role="group" aria-label="{{ section.settings.heading | escape }}">
        {%- for i in (1..5) -%}
          {%- liquid
            assign img_key = 'image_' | append: i
            assign img = section.settings[img_key]
            case i
              when 1, 5
                assign size_class = 'pt-about-hero__shot--sm'
              when 2, 4
                assign size_class = 'pt-about-hero__shot--md'
              else
                assign size_class = 'pt-about-hero__shot--lg'
            endcase
          -%}
          <div class="pt-about-hero__shot {{ size_class }}">
            {%- if img != blank -%}
              {%- assign shot_alt = img.alt | default: section.settings.heading -%}
              {{
                img
                | image_url: width: 600
                | image_tag:
                  loading: 'eager',
                  widths: '200, 300, 450, 600',
                  sizes: '(min-width: 990px) 200px, 18vw',
                  alt: shot_alt
              }}
            {%- else -%}
              <div class="pt-about-hero__ph" aria-hidden="true">Photo {{ i }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PATÉLLE — About hero",
  "tag": "section",
  "class": "section-patelle-about-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Learn about our journey, values, and commitment to creating exceptional digital experiences for modern businesses."
    },
    {
      "type": "header",
      "content": "Gallery (5 images — center is largest)"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (left)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3 (center)" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5 (right)" },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "presets": [{ "name": "PATÉLLE — About hero" }]
}
{% endschema %}
