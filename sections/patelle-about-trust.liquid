{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_about = false
  if page.handle == 'about' or template.suffix == 'about'
    assign show_about = true
  endif
-%}

{%- if show_about -%}
  <section
    class="pt-section pt-about-page pt-about-trust"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pt-wrap">
      <div class="pt-about-trust__row">
        {%- for block in section.blocks -%}
          <div class="pt-about-trust__item" {{ block.shopify_attributes }}>
            <span class="pt-about-trust__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'lasting' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'quality' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3.5l1.6 4.2 4.5.3-3.5 2.8 1.2 4.3L12 12.9 8.2 15.1l1.2-4.3-3.5-2.8 4.5-.3L12 3.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                {%- when 'guarantee' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'packaging' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 8.5L12 4.5l7.5 4v7l-7.5 4-7.5-4v-7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 12.5V20.5M4.5 8.5L12 12.5l7.5-4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                {%- when 'shipping' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 16.5V8.5h11v8M14.5 11.5h4l2 3v2h-6v-5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1.7" stroke="currentColor" stroke-width="1.4"/><circle cx="17" cy="16.5" r="1.7" stroke="currentColor" stroke-width="1.4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.label != blank -%}
              <p class="pt-about-trust__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PATÉLLE — About trust",
  "tag": "section",
  "class": "section-patelle-about-trust",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lasting", "label": "Long lasting" },
            { "value": "quality", "label": "Premium quality" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "packaging", "label": "Packaging" },
            { "value": "shipping", "label": "Shipping" }
          ],
          "default": "lasting"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Long Lasting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — About trust",
      "blocks": [
        { "type": "item", "settings": { "icon": "lasting", "label": "Long Lasting" } },
        { "type": "item", "settings": { "icon": "quality", "label": "Premium Quality" } },
        { "type": "item", "settings": { "icon": "guarantee", "label": "15-Day Satisfaction Guarantee" } },
        { "type": "item", "settings": { "icon": "packaging", "label": "Luxury Packaging" } },
        { "type": "item", "settings": { "icon": "shipping", "label": "USA Shipping" } }
      ]
    }
  ]
}
{% endschema %}
