{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom, mode: section.settings.spacing_mode -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-brand-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign h_align = section.settings.content_horizontal | default: 'start'
  assign v_align = section.settings.content_vertical | default: 'top'
-%}

<section
  class="pt-section pt-brand"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <div
      class="pt-brand__banner pt-brand__banner--h-{{ h_align }} pt-brand__banner--v-{{ v_align }}"
      style="--pt-brand-bg:{{ section.settings.background }};--pt-brand-gap:{{ section.settings.content_gap }}px;--pt-brand-inset:{{ section.settings.content_inset }}px;"
    >
      {%- if section.settings.image != blank -%}
        <img
          class="pt-brand__bg"
          src="{{ section.settings.image | image_url: width: 2880 }}"
          srcset="
            {{ section.settings.image | image_url: width: 1440 }} 1440w,
            {{ section.settings.image | image_url: width: 2160 }} 2160w,
            {{ section.settings.image | image_url: width: 2880 }} 2880w
          "
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          style="object-position:{{ section.settings.image.presentation.focal_point | default: 'center' }};"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pt-brand__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="pt-brand__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pt-brand__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                {%- endif -%}

              {%- when 'link' -%}
                {%- if block.settings.link_label != blank -%}
                  <a class="pt-brand__link pt-brand__link--{{ block.settings.position | default: 'inline' }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                    {{ block.settings.link_label }}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Brand banner",
  "tag": "section",
  "class": "section-patelle-brand",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fallback background",
      "default": "#7FA0C4"
    },
    {
      "type": "header",
      "content": "Content position"
    },
    {
      "type": "select",
      "id": "content_horizontal",
      "label": "Horizontal position",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space between blocks",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_inset",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Space from the left edge",
      "default": 15
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The perfume house for the next generation®"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Premium-quality French fragrances. No excessive markups. Crafted with heart, not ego."
        }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "About us"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "inline", "label": "Under the text" },
            { "value": "bottom", "label": "Bottom of the banner" }
          ],
          "default": "inline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Brand banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
