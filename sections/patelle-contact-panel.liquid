{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_contact = false
  if page.handle == 'contact' or template.suffix == 'contact'
    assign show_contact = true
  endif

  assign privacy_url = section.settings.privacy_link
  if privacy_url == blank and shop.privacy_policy != blank
    assign privacy_url = shop.privacy_policy.url
  endif
-%}

{%- if show_contact -%}
  <section
    class="pt-section pt-contact-panel"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="pt-wrap">
      <div class="pt-contact-panel__grid">
        <div class="pt-contact-panel__aside">
          <div class="pt-contact-panel__media">
            {%- if section.settings.image != blank -%}
              {%- assign panel_alt = section.settings.image.alt | default: shop.name -%}
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 420px, 100vw',
                  alt: panel_alt
              }}
            {%- else -%}
              <div class="pt-contact-panel__ph" aria-hidden="true">Product photo</div>
            {%- endif -%}
          </div>

          <div class="pt-contact-panel__info">
            {%- if section.settings.email != blank -%}
              <div class="pt-contact-panel__row">
                <span class="pt-contact-panel__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M4.5 7.5L12 12.5L19.5 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div class="pt-contact-panel__meta">
                  <p class="pt-contact-panel__label">{{ section.settings.email_label }}</p>
                  <a class="pt-contact-panel__value pt-contact-panel__value--link" href="mailto:{{ section.settings.email }}">
                    {{- section.settings.email -}}
                  </a>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.location != blank -%}
              <div class="pt-contact-panel__row">
                <span class="pt-contact-panel__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21s6.5-5.2 6.5-10.2A6.5 6.5 0 0 0 12 4.3a6.5 6.5 0 0 0-6.5 6.5C5.5 15.8 12 21 12 21z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <circle cx="12" cy="10.8" r="2.2" stroke="currentColor" stroke-width="1.4"/>
                  </svg>
                </span>
                <div class="pt-contact-panel__meta">
                  <p class="pt-contact-panel__label">{{ section.settings.location_label }}</p>
                  <p class="pt-contact-panel__value">{{ section.settings.location }}</p>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.hours != blank -%}
              <div class="pt-contact-panel__row">
                <span class="pt-contact-panel__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M12 7.8V12l3.2 1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M5.2 8.2C4.3 9.5 3.8 11 3.8 12.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                </span>
                <div class="pt-contact-panel__meta">
                  <p class="pt-contact-panel__label">{{ section.settings.hours_label }}</p>
                  <p class="pt-contact-panel__value">{{ section.settings.hours }}</p>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="pt-contact-panel__form-card">
          {%- if section.settings.form_heading != blank -%}
            <h2 class="pt-contact-panel__form-title">{{ section.settings.form_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.form_text != blank -%}
            <p class="pt-contact-panel__form-text">{{ section.settings.form_text }}</p>
          {%- endif -%}

          {%- form 'contact', id: 'PatelleContactForm', class: 'pt-contact-form' -%}
            {%- if form.posted_successfully? -%}
              <p class="pt-contact-form__status pt-contact-form__status--success" tabindex="-1" autofocus>
                {{ 'templates.contact.form.post_success' | t }}
              </p>
            {%- elsif form.errors -%}
              <div class="pt-contact-form__status pt-contact-form__status--error" role="alert" tabindex="-1" autofocus>
                <p>{{ 'templates.contact.form.error_heading' | t }}</p>
                <ul>
                  {%- for field in form.errors -%}
                    <li>
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="pt-contact-form__field">
              <label class="pt-contact-form__label" for="PatelleContact-name">
                {{- section.settings.label_name -}}
              </label>
              <input
                class="pt-contact-form__input"
                type="text"
                id="PatelleContact-name"
                name="contact[name]"
                autocomplete="name"
                placeholder="{{ section.settings.placeholder_name | escape }}"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                required
              >
            </div>

            <div class="pt-contact-form__field">
              <label class="pt-contact-form__label" for="PatelleContact-email">
                {{- section.settings.label_email -}}
              </label>
              <input
                class="pt-contact-form__input"
                type="email"
                id="PatelleContact-email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                placeholder="{{ section.settings.placeholder_email | escape }}"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>

            <div class="pt-contact-form__field">
              <label class="pt-contact-form__label" for="PatelleContact-phone">
                {{- section.settings.label_phone -}}
              </label>
              <div class="pt-contact-form__phone">
                <span class="pt-contact-form__dial" aria-hidden="true">
                  <span class="pt-contact-form__flag">🇺🇸</span>
                  US
                  <svg viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <input type="hidden" name="contact[country_code]" value="US">
                <input
                  class="pt-contact-form__input pt-contact-form__input--phone"
                  type="tel"
                  id="PatelleContact-phone"
                  name="contact[phone]"
                  autocomplete="tel"
                  placeholder="{{ section.settings.placeholder_phone | escape }}"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
              </div>
            </div>

            <div class="pt-contact-form__field">
              <label class="pt-contact-form__label" for="PatelleContact-body">
                {{- section.settings.label_message -}}
              </label>
              <textarea
                class="pt-contact-form__input pt-contact-form__textarea"
                id="PatelleContact-body"
                name="contact[body]"
                rows="5"
                placeholder="{{ section.settings.placeholder_message | escape }}"
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            {%- if section.settings.show_privacy -%}
              <label class="pt-contact-form__check">
                <input type="checkbox" name="contact[privacy_agreed]" value="Yes" required>
                <span>
                  {{ section.settings.privacy_text }}
                  {%- if privacy_url != blank -%}
                    <a href="{{ privacy_url }}" target="_blank" rel="noopener">
                      {{- section.settings.privacy_link_label -}}
                    </a>
                  {%- else -%}
                    <span class="pt-contact-form__policy">{{ section.settings.privacy_link_label }}</span>
                  {%- endif -%}
                </span>
              </label>
            {%- endif -%}

            <button type="submit" class="pt-contact-form__submit">
              {{ section.settings.button_label }}
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PATÉLLE — Contact panel",
  "tag": "section",
  "class": "section-patelle-contact-panel",
  "settings": [
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@patellefragrance.com"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label",
      "default": "Location"
    },
    {
      "type": "textarea",
      "id": "location",
      "label": "Location",
      "default": "3105 S 9th street, suite B, lafayette, in 47909"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Business Hours"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Monday - Friday 9:00 AM - 6:00 PM"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "form_text",
      "label": "Intro text",
      "default": "We’d love to hear from you. Whether you have questions about fragrances, samples, collaborations, or wholesale inquiries, our team is ready to assist."
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "First Name"
    },
    {
      "type": "text",
      "id": "placeholder_name",
      "label": "Name placeholder",
      "default": "Enter your name"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone label",
      "default": "Phone Number"
    },
    {
      "type": "text",
      "id": "placeholder_phone",
      "label": "Phone placeholder",
      "default": "+1 (555) 000-0000"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Message placeholder",
      "default": "Write your message"
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "Show privacy agreement",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy agreement text",
      "default": "I agree to with friendly"
    },
    {
      "type": "text",
      "id": "privacy_link_label",
      "label": "Privacy link label",
      "default": "privacy policy."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy policy link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button",
      "default": "Send Message"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "presets": [{ "name": "PATÉLLE — Contact panel" }]
}
{% endschema %}
