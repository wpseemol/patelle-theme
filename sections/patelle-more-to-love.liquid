{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-card.css' | asset_url | stylesheet_tag }}
{{ 'patelle-shop-all.css' | asset_url | stylesheet_tag }}
{{ 'patelle-more-to-love.css' | asset_url | stylesheet_tag }}

<section
  class="pt-section pt-more"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <div class="pt-more__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_view_all -%}
        <a
          class="pt-pill"
          href="{{ section.settings.view_all_url | default: section.settings.collection.url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="pt-grid pt-grid--3">
      {%- if section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- render 'patelle-card',
            card_product: product,
            card_style: 'stacked',
            section_id: section.id,
            tagline: section.settings.vendor_tagline,
            show_rating: section.settings.show_rating,
            index: forloop.index
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="pt-card pt-card--stacked">
            <div class="pt-card__media pt-card__placeholder">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'pt-card__placeholder-svg' }}
            </div>
            <div class="pt-card__body">
              <h3 class="pt-card__title">Choose a collection</h3>
              <p class="pt-card__vendor">Set one in the theme editor to fill this row.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — More to Love",
  "tag": "section",
  "class": "section-patelle-more",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More to Love"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "vendor_tagline",
      "label": "Vendor tagline",
      "default": "(Luxury. No Markup.)"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Uses the product's reviews rating metafield when available.",
      "default": true
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — More to Love"
    }
  ]
}
{% endschema %}
