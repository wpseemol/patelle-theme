{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-news-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign article = blank
  if section.settings.blog != blank
    assign article = blogs[section.settings.blog].articles.first
  endif

  assign heading = section.settings.heading
  if heading == blank and article != blank
    assign heading = article.title
  endif

  assign strip_url = section.settings.link
  if strip_url == blank and article != blank
    assign strip_url = article.url
  endif

  assign strip_image = section.settings.image
  if strip_image == blank and article != blank
    assign strip_image = article.image
  endif

  assign strip_date = section.settings.date
  if strip_date == blank and article != blank
    assign strip_date = article.published_at | date: format: 'date'
  endif
-%}

<section
  class="pt-section pt-news"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <div class="pt-news__strip">
      <div class="pt-news__content">
        {%- if heading != blank -%}
          <h2 class="pt-news__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="pt-news__meta">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if strip_date != blank -%}
          <p class="pt-news__meta">{{ strip_date }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="pt-pill pt-pill--solid pt-news__cta" href="{{ strip_url | default: '#' }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if strip_image != blank -%}
        <div class="pt-news__media">
          <img
            src="{{ strip_image | image_url: width: 760 }}"
            srcset="
              {{ strip_image | image_url: width: 380 }} 380w,
              {{ strip_image | image_url: width: 760 }} 760w
            "
            sizes="(min-width: 990px) 330px, 40vw"
            alt="{{ strip_image.alt | escape }}"
            width="{{ strip_image.width }}"
            height="{{ strip_image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — News strip",
  "tag": "section",
  "class": "section-patelle-news",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "The newest article fills any field left empty below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chill Out, Shop On National Ice Cream Day"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Nolita Boutique ONLY"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — News strip"
    }
  ]
}
{% endschema %}
