{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-product.css' | asset_url | stylesheet_tag }}
{{ 'patelle-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'patelle-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'pt-product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign rating_value = section.settings.fallback_rating
  if rating != blank
    if rating.rating != blank
      assign rating_value = rating.rating
    else
      assign rating_value = rating
    endif
  endif
  if rating_count == blank
    assign rating_count = section.settings.fallback_review_count
  endif
  assign stars_filled = rating_value | plus: 0 | round

  assign short_desc = product.metafields.custom.short_description.value
  if short_desc == blank
    assign short_desc = section.settings.short_description
  endif

  assign gender = product.metafields.custom.gender.value | default: section.settings.gender
  assign inspired_by = product.metafields.custom.inspired_by.value | default: section.settings.inspired_by
  assign inspired_retail = product.metafields.custom.inspired_retail.value | default: section.settings.inspired_retail
  assign scent_family = product.metafields.custom.scent_family.value | default: section.settings.scent_family
  assign intensity_label = product.metafields.custom.scent_intensity.value | default: section.settings.intensity_label
  assign intensity_level = product.metafields.custom.intensity_level.value | default: section.settings.intensity_level
  assign qty_note = section.settings.quantity_note

  assign save_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<patelle-product-main
  class="pt-section pt-product-page pt-pdp-main pt-under-header"
  id="ProductMain-{{ section.id }}"
  data-section="{{ section.id }}"
  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-money-format="{% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | strip_html | escape }}{% else %}{{ shop.money_format | strip_html | escape }}{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <nav class="pt-pdp-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">›</span>
      <a href="{{ routes.all_products_collection_url }}">Product</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Product Details</span>
    </nav>

    <div class="pt-pdp-main__grid">
      {%- liquid
        assign gallery_sticky = section.settings.gallery_sticky | default: 'single'
        assign gallery_is_sticky = false
        if gallery_sticky == 'always'
          assign gallery_is_sticky = true
        elsif gallery_sticky == 'single' and media_count <= 1
          assign gallery_is_sticky = true
        endif
      -%}
      <div class="pt-pdp-gallery{% if media_count <= 1 %} pt-pdp-gallery--single{% endif %}{% if gallery_is_sticky %} pt-pdp-gallery--sticky{% endif %}">
        <div class="pt-pdp-gallery__main">
          {%- if product.featured_media -%}
            <img
              data-pt-gallery-main
              src="{{ product.featured_media | image_url: width: 1200 }}"
              srcset="
                {{ product.featured_media | image_url: width: 600 }} 600w,
                {{ product.featured_media | image_url: width: 900 }} 900w,
                {{ product.featured_media | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 990px) 700px, 92vw"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              loading="eager"
            >
          {%- else -%}
            <div class="pt-pdp-gallery__ph" aria-hidden="true">Product image</div>
          {%- endif -%}
        </div>

        {%- if media_count > 1 -%}
          <ul class="pt-pdp-gallery__grid" role="list">
            {%- for media in product.media offset: 1 limit: 4 -%}
              {%- assign preview = media.preview_image -%}
              {%- if preview != blank -%}
                {%- capture thumb_srcset -%}
                  {{- preview | image_url: width: 600 }} 600w, {{ preview | image_url: width: 900 }} 900w, {{ preview | image_url: width: 1200 }} 1200w
                {%- endcapture -%}
                <li>
                  <button
                    type="button"
                    class="pt-pdp-gallery__thumb"
                    data-pt-gallery-thumb
                    data-src="{{ preview | image_url: width: 1200 }}"
                    data-srcset="{{ thumb_srcset }}"
                    data-alt="{{ preview.alt | default: product.title | escape }}"
                    aria-label="Show this image larger"
                  >
                    <img
                      src="{{ preview | image_url: width: 900 }}"
                      srcset="{{ thumb_srcset }}"
                      sizes="(min-width: 990px) 330px, 46vw"
                      alt="{{ preview.alt | default: product.title | escape }}"
                      width="{{ preview.width }}"
                      height="{{ preview.height }}"
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="pt-pdp-info">
        <h1 class="pt-pdp-info__title">{{ product.title }}</h1>

        <div class="pt-pdp-info__rating">
          <span class="pt-pdp-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg
                viewBox="0 0 20 19"
                aria-hidden="true"
                focusable="false"
                {% if i > stars_filled %}
                  class="is-empty"
                {% endif %}
              >
                <path
                  d="M10 0l2.7 6.2 6.7.6-5.1 4.4 1.5 6.6L10 14.3 4.2 17.8l1.5-6.6L.6 6.8l6.7-.6L10 0z"
                  fill="currentColor"
                />
              </svg>
            {%- endfor -%}
          </span>
          <a
            class="pt-pdp-info__reviews"
            href="#pt-pdp-reviews"
            aria-label="{{ rating_value }} out of 5 stars, {{ rating_count }} reviews"
          >
            {{ rating_value }} ({{ rating_count }} Reviews)
          </a>
        </div>

        {%- if short_desc != blank -%}
          <p class="pt-pdp-info__tagline">{{ short_desc }}</p>
        {%- endif -%}

        <div class="pt-pdp-price-row">
          <s
            class="pt-pdp-price-row__compare"
            data-pt-compare
            {% if current_variant.compare_at_price <= current_variant.price %}
              hidden
            {% endif %}
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              {%- if settings.currency_code_enabled -%}
                {{ current_variant.compare_at_price | money_with_currency }}
              {%- else -%}
                {{ current_variant.compare_at_price | money }}
              {%- endif -%}
            {%- endif -%}
          </s>
          <span class="pt-pdp-price-row__current" data-pt-price>
            {%- if settings.currency_code_enabled -%}
              {{ current_variant.price | money_with_currency }}
            {%- else -%}
              {{ current_variant.price | money }}
            {%- endif -%}
          </span>
          <span
            class="pt-pdp-price-row__save"
            data-pt-save
            {% unless save_percent > 0 %}hidden{% endunless %}
          >
            Save <span data-pt-save-value>{{ save_percent }}</span>%
          </span>
        </div>

        <dl class="pt-pdp-specs">
          {%- if gender != blank -%}
            <div class="pt-pdp-specs__row">
              <dt>Gender:</dt>
              <dd>{{ gender }}</dd>
            </div>
          {%- endif -%}

          {%- if inspired_by != blank -%}
            <div class="pt-pdp-specs__row">
              <dt>Inspired By:</dt>
              <dd>
                {{ inspired_by }}
                {%- if inspired_retail != blank -%}
                  <span class="pt-pdp-specs__accent">(Retail Price: {{ inspired_retail }})</span>
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}

          {%- if scent_family != blank -%}
            <div class="pt-pdp-specs__row">
              <dt>Scent Family:</dt>
              <dd>{{ scent_family }}</dd>
            </div>
          {%- endif -%}

          {%- if intensity_label != blank -%}
            <div class="pt-pdp-specs__row pt-pdp-specs__row--intensity">
              <dt>Scent Intensity Scale:</dt>
              <dd>
                <span class="pt-pdp-intensity">
                  <span class="pt-pdp-intensity__label">{{ intensity_label }}</span>
                  <span class="pt-pdp-intensity__bars" aria-hidden="true">
                    {%- for i in (1..4) -%}
                      <span class="pt-pdp-intensity__bar{% if i <= intensity_level %} is-on{% endif %}"></span>
                    {%- endfor -%}
                  </span>
                  <button
                    type="button"
                    class="pt-pdp-intensity__help"
                    title="{{ section.settings.intensity_help | escape }}"
                    aria-label="{{ section.settings.intensity_help | escape }}"
                  >
                    ?
                  </button>
                </span>
              </dd>
            </div>
          {%- endif -%}
        </dl>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="pt-pdp-option">
              <legend class="pt-pdp-option__label">{{ option.name }}</legend>
              <div class="pt-pdp-option__values">
                {%- for value in option.values -%}
                  <div class="pt-pdp-option__value">
                    <input
                      type="radio"
                      id="pt-opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                      name="pt-option-{{ section.id }}-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-pt-option-input
                      data-option-position="{{ option.position }}"
                      {% if option.selected_value == value %}
                        checked
                      {% endif %}
                    >
                    <label for="pt-opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                      {{ value }}
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pt-pdp-actions">
          <product-form
            class="product-form"
            data-hide-errors="false"
            data-section-id="{{ section.id }}"
          >
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                class="product-variant-id"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >

              {%- liquid
                assign qty_rule = current_variant.quantity_rule
                assign qty_min = qty_rule.min | default: 1
                assign qty_step = qty_rule.increment | default: 1
                assign qty_max = qty_rule.max
                if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
                  if qty_max == null or current_variant.inventory_quantity < qty_max
                    assign qty_max = current_variant.inventory_quantity | at_least: qty_min
                  endif
                endif
              -%}
              <div class="pt-pdp-qty">
                <label class="pt-pdp-qty__label" for="pt-qty-{{ section.id }}">Quantity:</label>
                <div class="pt-pdp-qty__control">
                  <div class="pt-pdp-qty__stepper" data-pt-qty>
                    <button
                      type="button"
                      class="pt-pdp-qty__btn"
                      data-pt-qty-step="-1"
                      aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
                      disabled
                    >
                      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 6h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </button>
                    <input
                      id="pt-qty-{{ section.id }}"
                      class="pt-pdp-qty__input"
                      type="number"
                      name="quantity"
                      value="{{ qty_min }}"
                      min="{{ qty_min }}"
                      {% if qty_max != null %}
                        max="{{ qty_max }}"
                      {% endif %}
                      step="{{ qty_step }}"
                      inputmode="numeric"
                      data-pt-qty-input
                    >
                    <button
                      type="button"
                      class="pt-pdp-qty__btn"
                      data-pt-qty-step="1"
                      aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
                      {% if qty_max != null and qty_max <= qty_min %}
                        disabled
                      {% endif %}
                    >
                      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 6h8M6 2v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </button>
                  </div>
                  {%- if qty_note != blank -%}
                    <span class="pt-pdp-qty__note">{{ qty_note }}</span>
                  {%- endif -%}
                </div>
              </div>

              <div class="product-form__buttons">
                <button
                  type="submit"
                  name="add"
                  class="pt-pdp-atc"
                  {% unless current_variant.available %}
                    disabled
                    aria-disabled="true"
                  {% endunless %}
                >
                  <span data-pt-atc-label>
                    {%- if current_variant.available -%}
                      Add to Cart
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              </div>
            {%- endform -%}
          </product-form>
        </div>

        {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
        {%- if app_blocks.size > 0 -%}
          <div class="pt-pdp-info__apps">
            {%- for block in app_blocks -%}
              {% render block %}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
        {%- if trust_blocks.size > 0 -%}
          <div class="pt-pdp-trust">
            {%- for block in trust_blocks -%}
              <div class="pt-pdp-trust__item" {{ block.shopify_attributes }}>
                <span class="pt-pdp-trust__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'diamond' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5L20 10l-8 10.5L4 10l8-6.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M4 10h16" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4.2l2.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M5 18c4-1 7-4 8.5-8.5C15 5 18 3.5 20.5 4c-.4 3.5-2.5 7-7 9.5C9 16 6.5 17.5 5 18z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.5 14.5C8 16 6.5 17.2 5 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/></svg>
                  {%- endcase -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <p class="pt-pdp-trust__label">{{ block.settings.label }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign reel_blocks = section.blocks | where: 'type', 'reel' -%}
        {%- if reel_blocks.size > 0 -%}
          <div class="pt-pdp-reels pt-pdp-reels--inline">
            <div class="pt-pdp-reels__head">
              {%- if section.settings.reels_heading != blank -%}
                <h2 class="pt-pdp-info__subhead">{{ section.settings.reels_heading }}</h2>
              {%- endif -%}
              {%- if reel_blocks.size > 3 -%}
                <div class="pt-pdp-reels__nav">
                  <button type="button" class="pt-pdp-reels__arrow" data-pt-reels-prev aria-label="Previous reels">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button type="button" class="pt-pdp-reels__arrow" data-pt-reels-next aria-label="Next reels">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              {%- endif -%}
            </div>
            <div class="pt-pdp-reels__track" data-pt-reels-track>
              {%- for block in reel_blocks -%}
                {% render 'patelle-product-reel',
                  block: block,
                  sizes: '(min-width: 990px) 200px, 30vw',
                  fallback_alt: product.title,
                  show_label: false
                %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- render 'patelle-product-tabs', product: product, section: section -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-pt-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_min = variant.quantity_rule.min | default: 1
          assign v_max = variant.quantity_rule.max
          if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
            if v_max == null or variant.inventory_quantity < v_max
              assign v_max = variant.inventory_quantity | at_least: v_min
            endif
          endif
        -%}
        {
          "id": {{ variant.id | json }},
          "qty_min": {{ v_min | json }},
          "qty_step": {{ variant.quantity_rule.increment | default: 1 | json }},
          "qty_max": {{ v_max | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "options": {{ variant.options | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</patelle-product-main>

{% schema %}
{
  "name": "PATÉLLE — Product main",
  "tag": "section",
  "class": "section-patelle-product-main",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description",
      "default": "Visibly firms and smooths skin to reduce early signs of aging."
    },
    {
      "type": "text",
      "id": "fallback_rating",
      "label": "Fallback rating",
      "default": "4.7"
    },
    {
      "type": "text",
      "id": "fallback_review_count",
      "label": "Fallback review count",
      "default": "1,634"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "gallery_sticky",
      "label": "Keep images in view while scrolling (desktop)",
      "options": [
        { "value": "single", "label": "Only when the product has one image" },
        { "value": "always", "label": "Always" },
        { "value": "off", "label": "Off" }
      ],
      "default": "single",
      "info": "The images stay on screen while the details on the right scroll past. \"Always\" suits products with 1–3 images; a taller gallery can hide its last images."
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "text",
      "id": "gender",
      "label": "Gender",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "inspired_by",
      "label": "Inspired by",
      "default": "Yves Saint Laurent (YSL) Mon Paris"
    },
    {
      "type": "text",
      "id": "inspired_retail",
      "label": "Inspired retail price",
      "default": "$150"
    },
    {
      "type": "textarea",
      "id": "scent_family",
      "label": "Scent family",
      "default": "Fruity Floral Patchouli Size: YSL 50 ml / 1.7 oz EDP high concentration"
    },
    {
      "type": "text",
      "id": "intensity_label",
      "label": "Intensity label",
      "default": "Powerful"
    },
    {
      "type": "range",
      "id": "intensity_level",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Intensity bars filled",
      "info": "Product metafield custom.intensity_level overrides this.",
      "default": 3
    },
    {
      "type": "text",
      "id": "intensity_help",
      "label": "Intensity help text",
      "default": "How strong the fragrance projects and lasts on skin."
    },
    {
      "type": "text",
      "id": "quantity_note",
      "label": "Quantity note",
      "default": "Up to 3 Save 20%"
    },
    {
      "type": "header",
      "content": "Reels & notes"
    },
    {
      "type": "text",
      "id": "reels_heading",
      "label": "Reels heading",
      "default": "Real Results"
    },
    {
      "type": "text",
      "id": "notes_tab_label",
      "label": "Fragrance notes tab label",
      "info": "First tab. Reads metafields custom.scent_accords, custom.highlight_notes, custom.top_notes, custom.heart_notes, custom.base_notes, custom.ingredients; falls back to Scent accord, Key note and Detail blocks.",
      "default": "Fragrance Notes"
    },
    {
      "type": "text",
      "id": "notes_heading",
      "label": "Key notes heading",
      "default": "Highlight Notes:"
    },
    {
      "type": "text",
      "id": "notes_row_labels",
      "label": "Note row labels",
      "info": "Comma separated labels for metafields custom.top_notes, custom.heart_notes, custom.base_notes, custom.ingredients.",
      "default": "Top Notes:,Heart Notes:,Base Notes:,Ingredients:"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
