{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-product.css' | asset_url | stylesheet_tag }}

<section
  class="pt-section pt-product-page pt-pdp-promise"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pt-pdp-promise__bg" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw',
          alt: ''
      }}
    {%- else -%}
      <div class="pt-pdp-video__ph" style="min-height: 100%; border-radius: 0;"></div>
    {%- endif -%}
  </div>

  <div class="pt-wrap">
    <div class="pt-pdp-promise__panel pt-glass">
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-pdp-promise__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pt-pdp-promise__items">
          {%- for block in section.blocks -%}
            <div class="pt-pdp-promise__item" {{ block.shopify_attributes }}>
              <span class="pt-pdp-promise__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'natural' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20V10M12 10c2.5-4 6-5.5 8-4-1 4-4 7-8 8M12 10c-2.5-4-6-5.5-8-4 1 4 4 7 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'cruelty' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20.2s-6.8-4.2-8.8-8.2C1.6 8.6 3.2 5.5 6.4 5.2c1.7-.2 3.3.7 4.1 2.1.8-1.4 2.4-2.3 4.1-2.1 3.2.3 4.8 3.4 3.2 6.8-2 4-8.8 8.2-8.8 8.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  {%- when 'lasting' -%}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'eco' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M5 18c4-1 7-4 8.5-8.5C15 5 18 3.5 20.5 4c-.4 3.5-2.5 7-7 9.5C9 16 6.5 17.5 5 18z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.5 14.5C8 16 6.5 17.2 5 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  {%- when 'drop' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5s-6 6.6-6 10.8a6 6 0 0 0 12 0C18 10.1 12 3.5 12 3.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  {%- when 'quality' -%}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="9.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M9 14.2L7.5 20.5 12 18l4.5 2.5-1.5-6.3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/></svg>
                {%- endcase -%}
              </span>
              {%- if block.settings.label != blank -%}
                <p class="pt-pdp-promise__label">{{ block.settings.label }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Product promise",
  "tag": "section",
  "class": "section-patelle-product-promise",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Quality Promise"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "natural", "label": "Natural" },
            { "value": "cruelty", "label": "Cruelty free / Heart" },
            { "value": "lasting", "label": "Long lasting" },
            { "value": "eco", "label": "Eco friendly" },
            { "value": "drop", "label": "Drop / Skin safe" },
            { "value": "quality", "label": "Premium quality" }
          ],
          "default": "natural"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Natural Ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Product promise",
      "blocks": [
        { "type": "item", "settings": { "icon": "lasting", "label": "Long Lasting" } },
        { "type": "item", "settings": { "icon": "quality", "label": "Premium Quality" } },
        { "type": "item", "settings": { "icon": "cruelty", "label": "Cruelty Free & Vegan" } },
        { "type": "item", "settings": { "icon": "eco", "label": "Eco-Friendly Packaging" } },
        { "type": "item", "settings": { "icon": "drop", "label": "Skin Safe" } }
      ]
    }
  ]
}
{% endschema %}
