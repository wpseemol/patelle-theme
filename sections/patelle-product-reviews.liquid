{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'patelle-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign per_page = section.settings.reviews_per_page
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign score = section.settings.score
  if rating != blank
    if rating.rating != blank
      assign score = rating.rating
    else
      assign score = rating
    endif
  endif
  if rating_count == blank
    assign rating_count = section.settings.review_count_label
  endif
-%}

<section
  id="pt-pdp-reviews"
  class="pt-section pt-product-page pt-pdp-reviews"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="pt-pdp-reviews__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_summary -%}
    <div class="pt-pdp-reviews__summary">
      <div class="pt-pdp-reviews__score">
        <p class="pt-pdp-reviews__score-num">
          {{ score }}<span>/5</span>
        </p>
        <p class="pt-pdp-reviews__score-meta">({{ rating_count }})</p>
      </div>

      <div class="pt-pdp-bars" aria-hidden="true">
        {%- assign bar_values = section.settings.bar_5
          | append: ','
          | append: section.settings.bar_4
          | append: ','
          | append: section.settings.bar_3
          | append: ','
          | append: section.settings.bar_2
          | append: ','
          | append: section.settings.bar_1
          | split: ','
        -%}
        {%- for bar in bar_values -%}
          {%- assign star_n = 6 | minus: forloop.index -%}
          <div class="pt-pdp-bar">
            <span class="pt-pdp-bar__label">
              <svg viewBox="0 0 20 19" aria-hidden="true" focusable="false">
                <path d="M10 0l2.7 6.2 6.7.6-5.1 4.4 1.5 6.6L10 14.3 4.2 17.8l1.5-6.6L.6 6.8l6.7-.6L10 0z" fill="currentColor"/>
              </svg>
              {{ star_n }}
            </span>
            <div class="pt-pdp-bar__track">
              <span class="pt-pdp-bar__fill" style="width: {{ bar }}%;"></span>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="pt-pdp-reviews__cta">
        {%- if section.settings.cta_heading != blank -%}
          <p class="pt-pdp-reviews__cta-title">{{ section.settings.cta_heading }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <p class="pt-pdp-reviews__cta-text">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          {%- liquid
            if section.settings.cta_link != blank
              assign review_cta_href = section.settings.cta_link
            elsif app_blocks.size > 0
              assign review_cta_href = '#pt-pdp-reviews-app'
            else
              assign review_cta_href = '#pt-pdp-reviews'
            endif
          -%}
          <a class="pt-pdp-reviews__cta-btn" href="{{ review_cta_href }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}

    {%- if app_blocks.size > 0 -%}
      <div id="pt-pdp-reviews-app" class="pt-pdp-reviews__app">
        {%- for block in app_blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    {%- elsif review_blocks.size > 0 -%}
      <ul
        class="pt-pdp-reviews__list"
        role="list"
        data-pt-reviews-list
        data-step="{{ per_page }}"
        data-start="0"
        data-count="{{ per_page }}"
      >
        {%- for block in review_blocks -%}
            <li
              class="pt-pdp-review"
              {% if forloop.index > per_page %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="pt-pdp-review__head">
                {%- if block.settings.avatar != blank -%}
                  {{
                    block.settings.avatar
                    | image_url: width: 96
                    | image_tag:
                      class: 'pt-pdp-review__avatar',
                      loading: 'lazy',
                      widths: '48, 96',
                      sizes: '44px',
                      alt: block.settings.name
                  }}
                {%- else -%}
                  <span class="pt-pdp-review__avatar pt-pdp-review__avatar--ph" aria-hidden="true">
                    {{ block.settings.name | slice: 0 | upcase }}
                  </span>
                {%- endif -%}
                <div class="pt-pdp-review__meta">
                  {%- if block.settings.name != blank -%}
                    <p class="pt-pdp-review__name">{{ block.settings.name }}</p>
                  {%- endif -%}
                  {%- if block.settings.role != blank -%}
                    <p class="pt-pdp-review__role">{{ block.settings.role }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.when != blank -%}
                  <p class="pt-pdp-review__when">{{ block.settings.when }}</p>
                {%- endif -%}
              </div>

              <span class="pt-pdp-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg
                    viewBox="0 0 20 19"
                    aria-hidden="true"
                    focusable="false"
                    {% if i > block.settings.rating %}
                      class="is-empty"
                    {% endif %}
                  >
                    <path d="M10 0l2.7 6.2 6.7.6-5.1 4.4 1.5 6.6L10 14.3 4.2 17.8l1.5-6.6L.6 6.8l6.7-.6L10 0z" fill="currentColor"/>
                  </svg>
                {%- endfor -%}
              </span>

              {%- if block.settings.text != blank -%}
                <p class="pt-pdp-review__text">{{ block.settings.text }}</p>
              {%- endif -%}

              {%- assign photos_shown = 0 -%}
              {%- capture photo_markup -%}
                {%- for i in (1..4) -%}
                  {%- assign photo_key = 'photo_' | append: i -%}
                  {%- assign photo = block.settings[photo_key] -%}
                  {%- if photo != blank and photos_shown < 3 -%}
                    {%- assign photos_shown = photos_shown | plus: 1 -%}
                    <li>
                      {{
                        photo
                        | image_url: width: 400
                        | image_tag:
                          loading: 'lazy',
                          widths: '200, 300, 400',
                          sizes: '(min-width: 750px) 190px, 30vw',
                          alt: block.settings.name
                      }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if photo_markup != blank -%}
                <ul class="pt-pdp-review__photos" role="list">
                  {{ photo_markup }}
                </ul>
              {%- endif -%}
            </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_load_more and review_blocks.size > per_page -%}
        <div class="pt-pdp-reviews__pager">
          <button
            type="button"
            class="pt-pdp-reviews__arrow"
            data-pt-reviews-prev
            aria-label="Previous reviews"
            disabled
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M19 12H5m6-6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="pt-pdp-reviews__more-btn" data-pt-reviews-more>
            {{ section.settings.load_more_label }}
          </button>
          <button
            type="button"
            class="pt-pdp-reviews__arrow"
            data-pt-reviews-next
            aria-label="Next reviews"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 12h14m-6-6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Product reviews",
  "tag": "section",
  "class": "section-patelle-product-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rating & Reviews"
    },
    {
      "type": "paragraph",
      "content": "Add a review app block (e.g. Judge.me Review Widget) to show real reviews. When an app block is added, the sample review blocks are hidden."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "info": "Turn off if the review app shows its own summary.",
      "default": true
    },
    {
      "type": "text",
      "id": "score",
      "info": "Used when the product has no review app rating yet.",
      "label": "Average score",
      "default": "4.5"
    },
    {
      "type": "text",
      "id": "review_count_label",
      "label": "Review count label",
      "default": "50 New Reviews"
    },
    {
      "type": "range",
      "id": "bar_5",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "5-star bar",
      "default": 75
    },
    {
      "type": "range",
      "id": "bar_4",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "4-star bar",
      "default": 50
    },
    {
      "type": "range",
      "id": "bar_3",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "3-star bar",
      "default": 20
    },
    {
      "type": "range",
      "id": "bar_2",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "2-star bar",
      "default": 10
    },
    {
      "type": "range",
      "id": "bar_1",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "1-star bar",
      "default": 5
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Review this product"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Share your thoughts with other customers"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Write a customer review"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_load_more",
      "label": "Show load more and page arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "reviews_per_page",
      "min": 2,
      "max": 12,
      "step": 2,
      "label": "Reviews per page",
      "default": 2
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "Load More"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Rayam Islam"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Subtitle",
          "default": "Verified buyer"
        },
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "2 weeks ago"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Long-lasting and beautifully balanced. I get compliments every time I wear it — soft at first, then warm and grounded."
        },
        {
          "type": "image_picker",
          "id": "photo_1",
          "label": "Photo 1"
        },
        {
          "type": "image_picker",
          "id": "photo_2",
          "label": "Photo 2"
        },
        {
          "type": "image_picker",
          "id": "photo_3",
          "label": "Photo 3"
        },
        {
          "type": "image_picker",
          "id": "photo_4",
          "label": "Photo 4",
          "info": "Up to 3 photos are shown per review."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Product reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Rayam Islam",
            "role": "Verified buyer",
            "when": "2 weeks ago",
            "text": "Long-lasting and beautifully balanced. I get compliments every time I wear it — soft at first, then warm and grounded."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Maya Chen",
            "role": "Verified buyer",
            "when": "1 month ago",
            "text": "Smells expensive without the markup. The peony note is soft and the patchouli keeps it interesting all day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
