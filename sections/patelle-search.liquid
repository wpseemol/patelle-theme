{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom, mode: section.settings.spacing_mode -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-card.css' | asset_url | stylesheet_tag }}
{{ 'patelle-search.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<script src="{{ 'patelle-search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign terms = search.terms | escape
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms_param = search.terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: terms_param | append: '&options%5Bprefix%5D=last'
  assign has_results = false
  if search.performed and search.results_count > 0
    assign has_results = true
  endif
  assign popular = section.settings.popular_collection
  if popular == blank
    assign popular = collections.all
  endif
-%}

<section
  class="pt-section pt-search pt-search--cols-{{ section.settings.columns }}"
  style="--pt-search-pt: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <header class="pt-search__hero">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pt-search__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="pt-search__title">
        {%- if search.performed and search.terms != blank -%}
          {{ 'templates.search.search_for' | t: terms: search.terms }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="pt-search__form">
        <label class="visually-hidden" for="PtSearchInput-{{ section.id }}">{{ 'general.search.search' | t }}</label>
        <svg class="pt-search__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
          <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <input
          id="PtSearchInput-{{ section.id }}"
          class="pt-search__input"
          type="search"
          name="q"
          value="{{ terms }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="pt-pill pt-pill--solid pt-search__submit">
          {{- 'general.search.search' | t -}}
        </button>
      </form>

      {%- if search.performed -%}
        <p class="pt-search__count" role="status">
          {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
        </p>
      {%- endif -%}
    </header>

    {%- paginate search.results by section.settings.products_per_page -%}
      {%- if has_results -%}
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <form
            class="pt-search__toolbar"
            action="{{ routes.search_url }}"
            method="get"
            data-pt-search-filters
          >
            <input type="hidden" name="q" value="{{ terms }}">
            <input type="hidden" name="options[prefix]" value="last">

            <div class="pt-search__filters">
              {%- if section.settings.enable_filtering -%}
                {%- for filter in search.filters -%}
                  {%- case filter.type -%}
                    {%- when 'list', 'boolean' -%}
                      <details class="pt-search__filter" data-pt-filter>
                        <summary class="pt-search__chip{% if filter.active_values.size > 0 %} is-active{% endif %}">
                          {{ filter.label }}
                          {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
                          <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </summary>
                        <div class="pt-search__panel">
                          {%- for value in filter.values -%}
                            {%- liquid
                              assign disabled = false
                              if value.count == 0 and value.active == false
                                assign disabled = true
                              endif
                            -%}
                            <label class="pt-search__option{% if disabled %} is-disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}
                                  checked
                                {% endif %}
                                {% if disabled %}
                                  disabled
                                {% endif %}
                              >
                              <span>{{ value.label }}</span>
                              <span class="pt-search__option-count">{{ value.count }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </details>
                    {%- when 'price_range' -%}
                      {%- liquid
                        assign price_active = false
                        if filter.min_value.value != null or filter.max_value.value != null
                          assign price_active = true
                        endif
                      -%}
                      <details class="pt-search__filter" data-pt-filter>
                        <summary class="pt-search__chip{% if price_active %} is-active{% endif %}">
                          {{ filter.label }}
                          <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </summary>
                        <div class="pt-search__panel pt-search__panel--price">
                          <div class="pt-search__price">
                            <label>
                              <span>{{ 'products.facets.from' | t }}</span>
                              <input
                                type="number"
                                inputmode="decimal"
                                min="0"
                                name="{{ filter.min_value.param_name }}"
                                {% if filter.min_value.value %}
                                  value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                {% endif %}
                                placeholder="0"
                              >
                            </label>
                            <label>
                              <span>{{ 'products.facets.to' | t }}</span>
                              <input
                                type="number"
                                inputmode="decimal"
                                min="0"
                                name="{{ filter.max_value.param_name }}"
                                {% if filter.max_value.value %}
                                  value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                {% endif %}
                                placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              >
                            </label>
                          </div>
                          <button type="submit" class="pt-pill pt-pill--solid pt-search__apply">
                            {{- 'products.facets.apply' | t -}}
                          </button>
                        </div>
                      </details>
                  {%- endcase -%}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- if section.settings.enable_sorting -%}
              <label class="pt-search__sort">
                <span>{{ 'products.facets.sort_by_label' | t }}</span>
                <select name="sort_by" data-pt-search-sort>
                  {%- for option in search.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}

            <noscript>
              <button type="submit" class="pt-pill">{{ 'products.facets.apply' | t }}</button>
            </noscript>
          </form>

          {%- liquid
            assign active_count = 0
            for filter in search.filters
              assign active_count = active_count | plus: filter.active_values.size
              if filter.type == 'price_range'
                if filter.min_value.value != null or filter.max_value.value != null
                  assign active_count = active_count | plus: 1
                endif
              endif
            endfor
          -%}
          {%- if section.settings.enable_filtering and active_count > 0 -%}
            <div class="pt-search__active">
              {%- for filter in search.filters -%}
                {%- for value in filter.active_values -%}
                  <a class="pt-search__tag" href="{{ value.url_to_remove }}">
                    {{ value.label }}
                    <span aria-hidden="true">×</span>
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </a>
                {%- endfor -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                    <a class="pt-search__tag" href="{{ filter.url_to_remove }}">
                      {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
                      <span aria-hidden="true">×</span>
                    </a>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <a class="pt-search__clear" href="{{ clear_url }}">{{ 'products.facets.clear_all' | t }}</a>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- liquid
          assign product_count = 0
          for item in search.results
            if item.object_type == 'product'
              assign product_count = product_count | plus: 1
            endif
          endfor
          assign other_count = search.results.size | minus: product_count
        -%}

        {%- if product_count > 0 -%}
          <ul class="pt-search__grid" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li class="pt-search__item">
                  {%- render 'patelle-card',
                    card_product: item,
                    card_style: section.settings.card_style,
                    section_id: section.id,
                    tagline: section.settings.vendor_tagline,
                    show_rating: section.settings.show_rating,
                    index: forloop.index,
                    fit_image: section.settings.fit_image
                  -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if other_count > 0 -%}
          {%- if section.settings.content_heading != blank -%}
            <h2 class="pt-search__subhead">{{ section.settings.content_heading }}</h2>
          {%- endif -%}
          <ul class="pt-search__posts" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type != 'product' -%}
                <li>
                  <a class="pt-search__post" href="{{ item.url }}">
                    {%- if item.object_type == 'article' and item.image -%}
                      <span class="pt-search__post-media">
                        {{
                          item.image
                          | image_url: width: 480
                          | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 750px) 160px, 30vw', alt: item.title
                        }}
                      </span>
                    {%- endif -%}
                    <span class="pt-search__post-body">
                      <span class="pt-search__post-type">
                        {%- if item.object_type == 'article' -%}
                          {{ item.blog.title | default: 'Article' }}
                        {%- else -%}
                          {{ 'templates.search.page' | t }}
                        {%- endif -%}
                      </span>
                      <span class="pt-search__post-title">{{ item.title }}</span>
                      {%- liquid
                        if item.object_type == 'article'
                          assign excerpt = item.excerpt_or_content
                        else
                          assign excerpt = item.content
                        endif
                      -%}
                      <span class="pt-search__post-text">{{ excerpt | strip_html | truncatewords: 24 }}</span>
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <div class="pt-search__pager">
            {% render 'pagination', paginate: paginate, anchor: '' %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="pt-search__empty">
          {%- if search.performed -%}
            <p class="pt-search__empty-text" role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
          {%- elsif section.settings.empty_text != blank -%}
            <p class="pt-search__empty-text">{{ section.settings.empty_text }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_popular and popular.products_count > 0 -%}
          <div class="pt-search__popular">
            {%- if section.settings.popular_heading != blank -%}
              <h2 class="pt-search__subhead">{{ section.settings.popular_heading }}</h2>
            {%- endif -%}
            <ul class="pt-search__grid" role="list">
              {%- for product in popular.products limit: section.settings.popular_count -%}
                <li class="pt-search__item">
                  {%- render 'patelle-card',
                    card_product: product,
                    card_style: section.settings.card_style,
                    section_id: section.id,
                    tagline: section.settings.vendor_tagline,
                    show_rating: section.settings.show_rating,
                    index: forloop.index,
                    fit_image: section.settings.fit_image
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Search",
  "tag": "section",
  "class": "section-patelle-search",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading before a search",
      "info": "After a search the heading reads: Search for “term”.",
      "default": "Find your scent"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search field placeholder",
      "default": "Search fragrances, notes, collections"
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card design",
      "options": [
        { "value": "overlay", "label": "Overlay (same as homepage)" },
        { "value": "catalog", "label": "Catalog (name and price under the image)" }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "vendor_tagline",
      "label": "Vendor tagline",
      "visible_if": "{{ section.settings.card_style == 'overlay' }}",
      "default": "(Luxury. No Markup.)"
    },
    {
      "type": "checkbox",
      "id": "fit_image",
      "label": "Show full product image",
      "visible_if": "{{ section.settings.card_style == 'overlay' }}",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Show filters",
      "info": "Filters come from Search & Discovery app settings.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Show sorting",
      "default": true
    },
    {
      "type": "text",
      "id": "content_heading",
      "label": "Articles and pages heading",
      "default": "Articles & pages"
    },
    {
      "type": "header",
      "content": "No results"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text before a search",
      "default": "Type a scent name, a note like vanilla or oud, or a collection."
    },
    {
      "type": "checkbox",
      "id": "show_popular",
      "label": "Show popular products",
      "default": true
    },
    {
      "type": "text",
      "id": "popular_heading",
      "label": "Popular products heading",
      "visible_if": "{{ section.settings.show_popular }}",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "popular_collection",
      "label": "Popular products collection",
      "info": "Defaults to all products."
    },
    {
      "type": "range",
      "id": "popular_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Popular products to show",
      "visible_if": "{{ section.settings.show_popular }}",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ]
}
{% endschema %}
