{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-card.css' | asset_url | stylesheet_tag }}
{{ 'patelle-shop.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign card_style = section.settings.card_style | default: 'tile'
  assign show_wide = false
  if card_style == 'tile' and section.settings.wide_cards
    assign show_wide = true
  endif
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <collection-component
    view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
    data-collection-id="{{ collection.id }}"
  >
    <section
      class="pt-section pt-shop-page pt-shop-grid pt-shop-grid--cols-{{ section.settings.columns | default: '4' }} pt-shop-grid--{{ card_style }}"
      style="--pt-shop-grid-pt: {{ section.settings.padding_top }}px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      <div class="pt-wrap">
        {%- if collection.products.size == 0 -%}
          <p class="pt-shop-grid__empty" role="status">
            {{ 'sections.collection_template.empty' | t | default: 'No products found in this collection.' }}
          </p>
        {%- else -%}
          <ul class="pt-shop-grid__list" role="list">
            {%- for product in collection.products -%}
              {%- liquid
                assign pattern_pos = forloop.index0 | modulo: 7
                assign is_wide = false
                if show_wide
                  if pattern_pos == 0 or pattern_pos == 5
                    assign is_wide = true
                  endif
                endif
              -%}
              <li class="pt-shop-grid__item{% if is_wide %} pt-shop-grid__item--wide{% if pattern_pos == 0 %} pt-shop-grid__item--wide-first{% endif %}{% endif %}">
                {%- render 'patelle-card',
                  card_product: product,
                  card_style: card_style,
                  section_id: section.id,
                  tagline: section.settings.vendor_tagline,
                  show_rating: section.settings.show_rating,
                  index: forloop.index,
                  fit_image: section.settings.fit_image,
                  wide: is_wide
                -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <div class="pt-shop-grid__pager">
            {% render 'pagination', paginate: paginate, anchor: '' %}
          </div>
        {%- endif -%}
      </div>
    </section>
  </collection-component>
{%- endpaginate -%}

{% schema %}
{
  "name": "PATÉLLE — Shop grid",
  "tag": "section",
  "class": "section-patelle-shop-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 1,
      "label": "Products per page",
      "info": "14 fills the Figma pattern twice (a wide card, then a row of three, then a wide card).",
      "default": 14
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card design",
      "options": [
        { "value": "tile", "label": "Tiles (Figma shop page)" },
        { "value": "overlay", "label": "Overlay (same as homepage)" },
        { "value": "catalog", "label": "Catalog (name and price under the image)" }
      ],
      "default": "tile"
    },
    {
      "type": "checkbox",
      "id": "wide_cards",
      "label": "Wide cards",
      "info": "The 1st and 6th card of every 7 span two columns, like the Figma design. For the best look, give products a cut-out bottle photo in the metafield custom.card_image.",
      "visible_if": "{{ section.settings.card_style == 'tile' }}",
      "default": true
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "visible_if": "{{ section.settings.card_style != 'tile' }}",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "vendor_tagline",
      "label": "Vendor tagline",
      "visible_if": "{{ section.settings.card_style == 'overlay' }}",
      "default": "(Luxury. No Markup.)"
    },
    {
      "type": "checkbox",
      "id": "fit_image",
      "label": "Show full product image",
      "info": "Keeps the photo above the info panel so the bottle is not covered.",
      "visible_if": "{{ section.settings.card_style == 'overlay' }}",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "presets": [{ "name": "PATÉLLE — Shop grid" }]
}
{% endschema %}
