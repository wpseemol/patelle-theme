{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom, mode: section.settings.spacing_mode -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-shop.css' | asset_url | stylesheet_tag }}

<section
  class="pt-section pt-shop-page pt-shop-hero pt-under-header"
  style="--pt-shop-hero-pt: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pt-wrap">
    <div class="pt-shop-hero__intro">
      <h1 class="pt-shop-hero__title">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ collection.title }}
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="pt-shop-hero__text">{{ section.settings.text }}</p>
      {%- elsif collection.description != blank -%}
        <div class="pt-shop-hero__text">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="pt-shop-filters" aria-label="Shop categories">
        {%- for block in section.blocks -%}
          {%- liquid
            assign filter_url = '#'
            assign is_active = false

            if block.settings.collection != blank
              assign filter_url = block.settings.collection.url
              if block.settings.collection.handle == collection.handle
                assign is_active = true
              endif
            elsif block.settings.link != blank
              assign filter_url = block.settings.link
              if block.settings.link == collection.url or block.settings.link == request.path
                assign is_active = true
              endif
            elsif forloop.first
              assign filter_url = routes.all_products_collection_url
              if collection.handle == 'all'
                assign is_active = true
              endif
            endif
          -%}
          <a
            class="pt-shop-filter{% if is_active %} is-active{% endif %}"
            href="{{ filter_url }}"
            {% if is_active %}aria-current="page"{% endif %}
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Shop hero",
  "tag": "section",
  "class": "section-patelle-shop-hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore our full range of luxury fragrances — crafted for everyday presence, without the designer markup."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "info": "Space below the header.",
      "default": 92
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Used only when no collection is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Shop hero",
      "blocks": [
        { "type": "filter", "settings": { "label": "All" } },
        { "type": "filter", "settings": { "label": "Men" } },
        { "type": "filter", "settings": { "label": "Women" } },
        { "type": "filter", "settings": { "label": "Unisex" } },
        { "type": "filter", "settings": { "label": "Best Sellers" } },
        { "type": "filter", "settings": { "label": "New Arrivals" } }
      ]
    }
  ]
}
{% endschema %}
