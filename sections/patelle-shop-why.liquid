{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-shop.css' | asset_url | stylesheet_tag }}

<section
  class="pt-section pt-shop-page pt-shop-why"
  style="
    --pt-shop-why-bg: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pt-wrap">
    <div class="pt-shop-why__layout">
      <div class="pt-shop-why__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="pt-shop-why__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="pt-shop-why__features">
            {%- for block in section.blocks -%}
              <article class="pt-shop-why__feature" {{ block.shopify_attributes }}>
                <span class="pt-shop-why__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'delivery' -%}
                      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3.5 18.5h15.2V9.2H3.5v9.3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M18.7 12.2h5.2l3.1 3.6v2.7h-8.3v-6.3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <circle cx="8.2" cy="22.2" r="2.2" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="23.2" cy="22.2" r="2.2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M10.4 22.2h10.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                    {%- when 'shopping' -%}
                      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.2 9.5h15.6l-1.4 12.2a2 2 0 0 1-2 1.8H11.6a2 2 0 0 1-2-1.8L8.2 9.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M12.2 9.5V8.4a3.8 3.8 0 0 1 7.6 0v1.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                    {%- when 'secure' -%}
                      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 26.2s-8.2-4.4-8.2-10.6V8.8L16 5.8l8.2 3v6.8C24.2 21.8 16 26.2 16 26.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M12.8 15.4l2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'support' -%}
                      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="16" cy="16" r="9.2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M11.2 16.8c.4 2.2 2.2 3.8 4.8 3.8s4.4-1.6 4.8-3.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M12.2 13.2h.02M19.8 13.2h.02" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="16" cy="16" r="8.5" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                  {%- endcase -%}
                </span>
                <div>
                  {%- if block.settings.title != blank -%}
                    <h3 class="pt-shop-why__feature-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="pt-shop-why__feature-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pt-shop-why__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200',
              sizes: '(min-width: 990px) 520px, 92vw',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          <div class="pt-shop-why__ph" aria-hidden="true">Add image</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PATÉLLE — Shop why",
  "tag": "section",
  "class": "section-patelle-shop-why",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Customers Choose Patelle"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5ebde"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "shopping", "label": "Shopping" },
            { "value": "secure", "label": "Secure" },
            { "value": "support", "label": "Support" }
          ],
          "default": "delivery"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast & Reliable Delivery"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Enjoy quick and dependable shipping to your doorstep."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Shop why",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "delivery",
            "title": "Fast & Reliable Delivery",
            "text": "Enjoy quick and dependable shipping to your doorstep."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shopping",
            "title": "Easy Shopping",
            "text": "Browse our user-friendly shop with ease and find what you need."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "secure",
            "title": "Safe & Secure Payment",
            "text": "We ensure your products arrive safely and in perfect condition."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "support",
            "title": "Best Customer Service",
            "text": "Our team is here to help with samples, scents, and orders."
          }
        }
      ]
    }
  ]
}
{% endschema %}
