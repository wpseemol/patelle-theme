{%- render 'patelle-section-spacing', id: section.id, top: section.settings.margin_top, bottom: section.settings.margin_bottom -%}
{{ 'patelle-base.css' | asset_url | stylesheet_tag }}
{{ 'patelle-single-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'patelle-single-product.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.show_outline -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400&display=swap">
{%- endif -%}

{%- liquid
  assign sp = section.settings.product
  assign variant = blank
  assign main_image = blank
  assign product_url = '#'

  if sp != blank
    assign variant = sp.selected_or_first_available_variant
    assign main_image = sp.featured_image
    assign product_url = sp.url
  endif

  assign details_url = section.settings.button_link | default: product_url

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank and sp != blank
    assign eyebrow = sp.vendor
  endif

  assign inspired_by = section.settings.inspired_by
  assign inspired_retail = section.settings.inspired_retail
  if sp != blank
    if inspired_by == blank
      assign inspired_by = sp.metafields.custom.inspired_by.value
    endif
    if inspired_retail == blank
      assign inspired_retail = sp.metafields.custom.inspired_retail.value
    endif
  endif

  assign form_id = 'pt-sp-form-' | append: section.id
  assign thumb_limit = section.settings.thumbnails
-%}

<section
  class="pt-section pt-sp"
  style="
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
    --pt-sp-bg:{{ section.settings.background }};
    --pt-sp-accent:{{ section.settings.accent_color }};
    --pt-sp-outline:{{ section.settings.outline_color }};
  "
>
  {%- comment -%} Head — heading, outlined words, View Details {%- endcomment -%}
  <div class="pt-sp__head">
    {%- if section.settings.show_outline -%}
      {%- if section.settings.outline_word_1 != blank -%}
        <span class="pt-sp__outline pt-sp__outline--one" aria-hidden="true">{{ section.settings.outline_word_1 }}</span>
      {%- endif -%}
      {%- if section.settings.outline_word_2 != blank -%}
        <span class="pt-sp__outline pt-sp__outline--two" aria-hidden="true">{{ section.settings.outline_word_2 }}</span>
      {%- endif -%}
    {%- endif -%}

    <div class="pt-wrap">
      <div class="pt-sp__inner pt-sp__head-inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="pt-sp__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="pt-pill pt-sp__details-btn" href="{{ details_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Main — image + product info {%- endcomment -%}
  <div class="pt-wrap">
    <pt-single-gallery class="pt-sp__inner pt-sp__main">
      <div class="pt-sp__media{% if main_image == blank %} pt-sp__media--empty{% endif %}">
        {%- if main_image != blank -%}
          <img
            data-main-image
            src="{{ main_image | image_url: width: 1200 }}"
            srcset="
              {{ main_image | image_url: width: 600 }} 600w,
              {{ main_image | image_url: width: 900 }} 900w,
              {{ main_image | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 990px) 600px, 100vw"
            alt="{{ main_image.alt | default: sp.title | escape }}"
            width="{{ main_image.width }}"
            height="{{ main_image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pt-sp__placeholder' }}
        {%- endif -%}
      </div>

      <div class="pt-sp__info">
        {%- if eyebrow != blank -%}
          <p class="pt-sp__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}

        <h3 class="pt-sp__title">
          {%- if sp != blank -%}
            <a href="{{ product_url }}">{{ sp.title }}</a>
          {%- else -%}
            Select a product
          {%- endif -%}
        </h3>

        <p class="pt-sp__price">
          {%- if variant != blank -%}
            {{ variant.price | money }}
          {%- else -%}
            {{ 6900 | money }}
          {%- endif -%}
        </p>

        {%- if section.settings.show_inspired and inspired_by != blank -%}
          <p class="pt-sp__inspired">
            Inspired by:{{ inspired_by }}
            {%- if inspired_retail != blank %}
              <span class="pt-sp__accent">(Retail Price: {{ inspired_retail }})</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <div class="pt-sp__actions">
          {%- if variant != blank and variant.available -%}
            <product-form data-section-id="{{ section.id }}">
              {%- form 'product',
                sp,
                id: form_id,
                class: 'pt-sp__form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
                <button type="submit" name="add" class="pt-pill pt-sp__btn">
                  {{ section.settings.add_to_cart_label }}
                </button>
              {%- endform -%}
            </product-form>

            <a
              class="pt-pill pt-pill--solid pt-sp__btn"
              href="{{ routes.cart_add_url }}?id={{ variant.id }}&quantity=1&return_to=/checkout"
            >
              {{ section.settings.buy_now_label }}
            </a>
          {%- elsif variant != blank -%}
            <span class="pt-pill pt-sp__btn pt-sp__btn--disabled" aria-disabled="true">Sold out</span>
          {%- else -%}
            <span class="pt-pill pt-sp__btn">{{ section.settings.add_to_cart_label }}</span>
            <span class="pt-pill pt-pill--solid pt-sp__btn">{{ section.settings.buy_now_label }}</span>
          {%- endif -%}
        </div>

        {%- if sp != blank and thumb_limit > 0 and sp.media.size > 1 -%}
          <ul class="pt-sp__thumbs" role="list">
            {%- for media in sp.media limit: thumb_limit -%}
              {%- assign thumb = media.preview_image -%}
              <li>
                <button
                  type="button"
                  class="pt-sp__thumb"
                  data-thumb
                  data-src="{{ thumb | image_url: width: 1200 }}"
                  data-srcset="{{ thumb | image_url: width: 600 }} 600w, {{ thumb | image_url: width: 900 }} 900w, {{ thumb | image_url: width: 1200 }} 1200w"
                  data-alt="{{ thumb.alt | default: sp.title | escape }}"
                  aria-label="Show image {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  <img
                    src="{{ thumb | image_url: width: 160 }}"
                    srcset="{{ thumb | image_url: width: 80 }} 80w, {{ thumb | image_url: width: 160 }} 160w"
                    sizes="78px"
                    alt=""
                    width="78"
                    height="78"
                    loading="lazy"
                  >
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </pt-single-gallery>
  </div>

  {%- comment -%} Details strip — detail rows + checklist {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="pt-wrap">
      <div class="pt-sp__strip">
        <div class="pt-sp__inner pt-sp__strip-inner">
          <ul class="pt-sp__specs" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'detail' -%}
                {%- liquid
                  assign source = block.settings.source
                  assign value = block.settings.value
                  assign retail = blank

                  if value == blank and sp != blank
                    case source
                      when 'inspired_by'
                        assign value = sp.metafields.custom.inspired_by.value
                      when 'scent_family'
                        assign value = sp.metafields.custom.scent_family.value
                      when 'scent_intensity'
                        assign value = sp.metafields.custom.scent_intensity.value
                    endcase
                  endif

                  if source == 'inspired_by'
                    assign retail = block.settings.retail
                    if retail == blank and sp != blank
                      assign retail = sp.metafields.custom.inspired_retail.value
                    endif
                  endif
                -%}
                {%- if value != blank -%}
                  <li class="pt-sp__spec" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank -%}
                      <span class="pt-sp__spec-label{% if block.settings.bold_label %} pt-sp__spec-label--bold{% endif %}">
                        {{- block.settings.label -}}
                      </span>
                    {%- endif -%}
                    {%- if source == 'inspired_by' -%}
                      <span class="pt-sp__spec-value">{{ value }}</span>
                      {%- if retail != blank %}
                        <span class="pt-sp__accent">(Retail Price: {{ retail }})</span>
                      {%- endif -%}
                    {%- else %}
                      <span class="pt-sp__spec-value pt-sp__accent">{{ value }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <ul class="pt-sp__features" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' and block.settings.text != blank -%}
                <li class="pt-sp__feature" {{ block.shopify_attributes }}>
                  <svg class="pt-sp__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M2.5 8.5 6 12l7.5-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "PATÉLLE — Single product",
  "tag": "section",
  "class": "section-patelle-single-product",
  "max_blocks": 12,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "With Its Unique Taste, You Should Definitely Buy It!"
    },
    {
      "type": "checkbox",
      "id": "show_outline",
      "label": "Show outlined words",
      "default": true
    },
    {
      "type": "text",
      "id": "outline_word_1",
      "visible_if": "{{ section.settings.show_outline }}",
      "label": "Outlined word (top right)",
      "default": "ALMOND"
    },
    {
      "type": "text",
      "id": "outline_word_2",
      "visible_if": "{{ section.settings.show_outline }}",
      "label": "Outlined word (left)",
      "default": "AMBER"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Details button label",
      "default": "View Details"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Details button link",
      "info": "Leave empty to link to the product."
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Text above title",
      "info": "Leave empty to use the product vendor.",
      "default": "Patelle Perfume"
    },
    {
      "type": "checkbox",
      "id": "show_inspired",
      "label": "Show \"Inspired by\" under price",
      "default": true
    },
    {
      "type": "text",
      "id": "inspired_by",
      "visible_if": "{{ section.settings.show_inspired }}",
      "label": "Inspired by",
      "info": "Leave empty to use the product's custom.inspired_by metafield."
    },
    {
      "type": "text",
      "id": "inspired_retail",
      "visible_if": "{{ section.settings.show_inspired }}",
      "label": "Retail price",
      "info": "Leave empty to use the product's custom.inspired_retail metafield."
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy now label",
      "default": "Buy it Now"
    },
    {
      "type": "range",
      "id": "thumbnails",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Thumbnails to show",
      "info": "Uses the product's images. Set to 0 to hide.",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (retail price & values)",
      "default": "#B8924F"
    },
    {
      "type": "color",
      "id": "outline_color",
      "label": "Outlined words",
      "default": "#CFCFCF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Spacing control",
      "info": "Padding adds space inside the section background. Margin adds space outside it.",
      "options": [
        { "value": "padding", "label": "Padding" },
        { "value": "margin", "label": "Margin" }
      ],
      "default": "padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'padding' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "margin_top",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "visible_if": "{{ section.settings.spacing_mode == 'margin' }}",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail row (left)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Scent Family:"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Value source",
          "options": [
            { "value": "custom", "label": "Custom text" },
            { "value": "inspired_by", "label": "Product: Inspired by" },
            { "value": "scent_family", "label": "Product: Scent family" },
            { "value": "scent_intensity", "label": "Product: Scent intensity" }
          ],
          "default": "custom"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "When filled, this replaces the product data.",
          "default": "Amber Woody Floral"
        },
        {
          "type": "text",
          "id": "retail",
          "visible_if": "{{ block.settings.source == 'inspired_by' }}",
          "label": "Retail price",
          "info": "Leave empty to use the product's custom.inspired_retail metafield."
        },
        {
          "type": "checkbox",
          "id": "bold_label",
          "label": "Bold label",
          "default": false
        }
      ]
    },
    {
      "type": "feature",
      "name": "Checklist item (right)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping on Orders $75+"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PATÉLLE — Single product",
      "blocks": [
        {
          "type": "detail",
          "settings": { "label": "Inspired by:", "source": "inspired_by", "value": "Baccarat Rouge 540 Extrait", "retail": "$168" }
        },
        {
          "type": "detail",
          "settings": { "label": "Scent Family:", "source": "scent_family", "value": "Amber Woody Floral" }
        },
        {
          "type": "detail",
          "settings": { "label": "Scent Intensity Scale:", "source": "scent_intensity", "value": "Powerful", "bold_label": true }
        },
        { "type": "feature", "settings": { "text": "Free Shipping on Orders $75+" } },
        { "type": "feature", "settings": { "text": "Long Lasting Eau de Parfum" } },
        { "type": "feature", "settings": { "text": "Buy Now, Pay Later Available" } }
      ]
    }
  ]
}
{% endschema %}
