{% comment %}
  PATÉLLE product tile (Figma Shop Page 232-738): white card, rating and heart on top,
  centered bottle, name, prices and a round bag button at the bottom.
  Rendered through patelle-card with card_style: 'tile'.

  Accepts:
  - card_product {Object}  product
  - section_id   {String}
  - show_rating  {Boolean}
  - index        {Number}  loop index, used to build unique form ids
  - wide         {Boolean} card spans two grid columns; the bottle fills the card height

  Image: product metafield custom.card_image (a cut-out bottle on a transparent or white
  background) first, then the featured image.
{% endcomment %}

{%- liquid
  assign variant = card_product.selected_or_first_available_variant
  assign form_id = 'pt-tile-' | append: section_id | append: '-' | append: card_product.id | append: '-' | append: index
  assign tile_media = card_product.metafields.custom.card_image.value
  if tile_media == blank
    assign tile_media = card_product.featured_media
  endif

  assign rating = card_product.metafields.reviews.rating.value
  assign rating_value = 4.8
  if rating != blank
    if rating.rating != blank
      assign rating_value = rating.rating
    else
      assign rating_value = rating
    endif
  endif

  assign tile_sizes = '(min-width: 990px) 360px, (min-width: 750px) 45vw, 46vw'
  if wide
    assign tile_sizes = '(min-width: 990px) 420px, 92vw'
  endif
-%}

<div class="pt-card pt-card--tile{% if wide %} pt-card--tile-wide{% endif %}">
  <a
    class="pt-card__media"
    href="{{ card_product.url }}"
    aria-label="{{ card_product.title | escape }}"
    tabindex="-1"
  >
    {%- if tile_media != blank -%}
      <img
        src="{{ tile_media | image_url: width: 720 }}"
        srcset="
          {{ tile_media | image_url: width: 360 }} 360w,
          {{ tile_media | image_url: width: 720 }} 720w,
          {{ tile_media | image_url: width: 1080 }} 1080w
        "
        sizes="{{ tile_sizes }}"
        alt="{{ tile_media.alt | default: card_product.title | escape }}"
        width="{{ tile_media.preview_image.width | default: 1000 }}"
        height="{{ tile_media.preview_image.height | default: 1000 }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pt-card__placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="pt-card__top">
    {%- if show_rating -%}
      <span class="pt-card__score" role="img" aria-label="{{ rating_value }} out of 5 stars">
        <svg viewBox="0 0 20 19" aria-hidden="true" focusable="false">
          <path d="M10 0l2.7 6.2 6.7.6-5.1 4.4 1.5 6.6L10 14.3 4.2 17.8l1.5-6.6L.6 6.8l6.7-.6L10 0z" fill="currentColor"/>
        </svg>
        <span aria-hidden="true">{{ rating_value }}</span>
      </span>
    {%- endif -%}

    <a class="pt-card__icon-btn pt-card__wish" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path
          d="M12 20.2s-6.8-4.2-8.8-8.2C1.6 8.6 3.2 5.5 6.4 5.2c1.7-.2 3.3.7 4.1 2.1.8-1.4 2.4-2.3 4.1-2.1 3.2.3 4.8 3.4 3.2 6.8-2 4-8.8 8.2-8.8 8.2z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>

  <div class="pt-card__body">
    <div class="pt-card__info">
      <h3 class="pt-card__title">
        <a href="{{ card_product.url }}" title="{{ card_product.title | escape }}">{{ card_product.title }}</a>
      </h3>
      <p class="pt-card__price">
        {%- if variant.compare_at_price > variant.price -%}
          <s class="pt-card__price-was">
            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
            {{- variant.compare_at_price | money -}}
          </s>
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
        {%- endif -%}
        <span class="pt-card__price-now">
          {%- if settings.currency_code_enabled -%}
            {{ variant.price | money_with_currency }}
          {%- else -%}
            {{ variant.price | money }}
          {%- endif -%}
        </span>
        {%- unless card_product.available -%}
          <span class="pt-card__soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- endunless -%}
      </p>
    </div>

    {%- capture bag_icon -%}
      <svg class="pt-card__bag-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M5.5 8.5h13l-1 11.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3l-1-11.2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    {%- endcapture -%}

    {%- if card_product.available -%}
      <product-form data-section-id="{{ section_id }}">
        {%- form 'product',
          card_product,
          id: form_id,
          class: 'pt-card__form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
          <button
            id="{{ form_id }}-submit"
            type="submit"
            name="add"
            class="pt-card__icon-btn pt-card__bag"
            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_product.title | escape }}"
          >
            <span class="visually-hidden">{{ 'products.product.add_to_cart' | t }}</span>
            {{ bag_icon }}
            <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- else -%}
      <button
        type="button"
        class="pt-card__icon-btn pt-card__bag"
        disabled
        aria-label="{{ 'products.product.sold_out' | t }}: {{ card_product.title | escape }}"
      >
        {{ bag_icon }}
      </button>
    {%- endif -%}
  </div>
</div>
