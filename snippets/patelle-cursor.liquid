{%- comment -%}
  Custom character cursor. Controlled from Theme settings → Custom cursor.
{%- endcomment -%}
{%- if settings.cursor_enable -%}
  {%- liquid
    case settings.cursor_style
      when 'bottle'
        assign ptr_fill = '#f7c9d3'
        assign ptr_line = '#7a3b4a'
        assign star_colors = '#f7c9d3,#d4af37,#ee8fa3'
      when 'bunny'
        assign ptr_fill = '#f7b6c2'
        assign ptr_line = '#6b5b53'
        assign star_colors = '#f7b6c2,#ffffff,#ee8fa3'
      when 'bear'
        assign ptr_fill = '#e6bb90'
        assign ptr_line = '#5a3a22'
        assign star_colors = '#e6bb90,#f28ca5,#b07a4f'
      when 'cat'
        assign ptr_fill = '#f4a259'
        assign ptr_line = '#6b3e1a'
        assign star_colors = '#f4a259,#fde2c4,#f28ca5'
      else
        assign ptr_fill = '#9ddcc0'
        assign ptr_line = '#2f5d50'
        assign star_colors = '#9ddcc0,#f2c94c,#f19c9c'
    endcase

    if settings.cursor_pointer_fill != blank
      assign ptr_fill = settings.cursor_pointer_fill | color_to_hex
    endif
    if settings.cursor_pointer_outline != blank
      assign ptr_line = settings.cursor_pointer_outline | color_to_hex
    endif

    if settings.cursor_image != blank
      assign cursor_src = settings.cursor_image | image_url: width: 240
    else
      assign cursor_file = 'patelle-cursor-' | append: settings.cursor_style | append: '.svg'
      assign cursor_src = cursor_file | asset_url
    endif
    assign cursor_height = settings.cursor_size | times: 1.25 | round

    assign cursor_offset = 12
    if settings.cursor_pointer == 'hidden'
      assign cursor_offset = 0
    endif
  -%}

  {%- if settings.cursor_pointer == 'themed' -%}
    {%- capture ptr_arrow -%}
      <svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><path d='M3.5 3l21.5 9.6-9.8 3.3-3.4 9.9z' fill='{{ ptr_fill }}' stroke='{{ ptr_line }}' stroke-width='2.6' stroke-linejoin='round'/></svg>
    {%- endcapture -%}
    {%- capture ptr_hand -%}
      <svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><path d='M11 4.8a2.3 2.3 0 0 1 4.6 0v8.4l.9-.2a2.1 2.1 0 0 1 2.5 1.3 2.1 2.1 0 0 1 2.8 1.2 2.1 2.1 0 0 1 3 1.7l.5 5.1c.3 3.6-2.1 6.8-5.7 7.4l-1.7.3a6.6 6.6 0 0 1-6.2-2.5l-5.1-6.4a2.2 2.2 0 0 1 3.4-2.8l1 1.2z' fill='{{ ptr_fill }}' stroke='{{ ptr_line }}' stroke-width='1.8' stroke-linejoin='round'/><path d='M15.6 13.2v4.6M19 14.3v4M21.8 15.5v3.5' stroke='{{ ptr_line }}' stroke-width='1.4' stroke-linecap='round'/></svg>
    {%- endcapture -%}
    {%- liquid
      assign ptr_arrow = ptr_arrow | strip | replace: '<', '%3C' | replace: '>', '%3E' | replace: '#', '%23'
      assign ptr_hand = ptr_hand | strip | replace: '<', '%3C' | replace: '>', '%3E' | replace: '#', '%23'
    -%}
    <style>
      @media (hover: hover) and (pointer: fine) {
        html,
        body {
          cursor: url("data:image/svg+xml,{{ ptr_arrow }}") 3 3, auto;
        }

        a,
        button,
        [role='button'],
        label,
        select,
        summary,
        video,
        input[type='submit'],
        input[type='button'],
        input[type='checkbox'],
        input[type='radio'],
        .card-wrapper,
        .pt-card {
          cursor: url("data:image/svg+xml,{{ ptr_hand }}") 13 3, pointer !important;
        }

        input:not([type='button'], [type='submit'], [type='reset'], [type='checkbox'], [type='radio'], [type='range'], [type='color'], [type='file']),
        textarea,
        [contenteditable='true'] {
          cursor: text;
        }
      }
    </style>
  {%- endif -%}

  {{ 'patelle-cursor.css' | asset_url | stylesheet_tag }}
  <div
    class="pt-cursor{% if settings.cursor_playful %} pt-cursor--playful{% endif %}"
    data-pt-cursor
    data-follow="{{ settings.cursor_follow }}"
    data-pointer="{{ settings.cursor_pointer }}"
    {% if settings.cursor_stars %}
      data-stars="{{ star_colors }}"
    {% endif %}
    style="--pt-cursor-size: {{ settings.cursor_size }}px; --pt-cursor-offset: {{ cursor_offset }}px;"
    aria-hidden="true"
  >
    <div class="pt-cursor__offset" data-pt-cursor-offset>
      <div class="pt-cursor__tilt">
        <img
          class="pt-cursor__img"
          src="{{ cursor_src }}"
          alt=""
          width="{{ settings.cursor_size }}"
          height="{{ cursor_height }}"
          draggable="false"
        >
      </div>
    </div>
  </div>
  <script src="{{ 'patelle-cursor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
