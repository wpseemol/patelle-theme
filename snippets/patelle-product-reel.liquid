{% comment %}
  PATÉLLE product reel tile. Play opens the floating reel player
  (assets/patelle-product.js) on the same page.

  Accepts:
  - block   {Object}  reel block (image, video, video_url, label)
  - sizes   {String}  image sizes attribute
  - fallback_alt {String}
  - show_label {Boolean} caption under the tile
{% endcomment %}

{%- liquid
  assign reel_video = block.settings.video
  assign reel_url = block.settings.video_url
  assign reel_label = block.settings.label | default: fallback_alt
-%}

<article class="pt-pdp-reel" data-pt-reel {{ block.shopify_attributes }}>
  <div class="pt-pdp-reel__media">
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          widths: '240, 360, 480, 600',
          sizes: sizes,
          alt: reel_label
      }}
    {%- elsif reel_video != blank -%}
      {{
        reel_video.preview_image
        | image_url: width: 600
        | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', sizes: sizes, alt: reel_label
      }}
    {%- else -%}
      <div class="pt-pdp-reel__ph" aria-hidden="true">Reel</div>
    {%- endif -%}

    {%- if reel_video != blank or reel_url != blank -%}
      <button
        type="button"
        class="pt-pdp-reel__play"
        data-pt-reel-open
        data-label="{{ reel_label | escape }}"
        {% if reel_url != blank %}
          data-url="{{ reel_url | escape }}"
        {% endif %}
        aria-label="Play reel{% if block.settings.label != blank %} — {{ block.settings.label | escape }}{% endif %}"
      >
        <span class="pt-pdp-reel__play-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M8.5 5.8v12.4L19 12 8.5 5.8z"/>
          </svg>
        </span>
      </button>
      {%- if reel_video != blank -%}
        <template data-pt-reel-video>
          {{-
            reel_video
            | video_tag:
              image_size: '720x',
              autoplay: true,
              loop: true,
              muted: false,
              controls: true,
              playsinline: true,
              class: 'pt-pdp-player__media'
          -}}
        </template>
      {%- endif -%}
    {%- else -%}
      <span class="pt-pdp-reel__play" aria-hidden="true">
        <span class="pt-pdp-reel__play-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
            <path d="M8.5 5.8v12.4L19 12 8.5 5.8z"/>
          </svg>
        </span>
      </span>
    {%- endif -%}
  </div>
  {%- if show_label and block.settings.label != blank -%}
    <p class="pt-pdp-reel__label">{{ block.settings.label }}</p>
  {%- endif -%}
</article>
