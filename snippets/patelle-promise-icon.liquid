{%- comment -%}
  Line icons for the PATÉLLE promise rows (Quality promise, Contact promise).
  Accepts: icon — hand, leaf, heart, planet, drop, star, shield, truck, gift, clock.
  The older Contact promise names (lasting, quality, guarantee, packaging,
  shipping) map to the matching icon.
{%- endcomment -%}
{%- case icon -%}
  {%- when 'hand', 'lasting' -%}
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M8.2 5.6a1.2 1.2 0 0 1 2.4 0v5h.5V3.4a1.2 1.2 0 0 1 2.4 0v7.2h.5V4.4a1.2 1.2 0 0 1 2.4 0v6.9h.5V6.6a1.2 1.2 0 0 1 2.4 0v7.6c0 4.2-3 7.3-7 7.3-2.4 0-4.2-1-5.6-2.9l-3.2-4.4a1.25 1.25 0 0 1 1.9-1.6l2.8 2.6V5.6z"/>
      <path d="M3.2 6.2c.4-1.3 1.2-2.4 2.3-3.1M1.6 5.5C2.1 3.7 3.2 2.2 4.7 1.2M19.6 20.4c1.2-.6 2.1-1.6 2.6-2.8M20.7 22.5c1.6-.8 2.8-2.1 3.3-3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'leaf', 'quality' -%}
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path fill-rule="evenodd" d="M21 3c.9 8.6-2.2 16-10.2 16-1.6 0-2.9-.4-3.9-1l-3 3-1.3-1.3 3-3c-.6-1-1-2.3-1-3.9C4.6 5.5 12.2 3 21 3zM8.4 16.9c1.8-4.3 4.7-7.6 8.8-10-3.7 1.4-6.9 4.6-9.3 8.9l.5 1.1z"/>
    </svg>
  {%- when 'heart', 'guarantee' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M12 20.5s-7.6-4.6-9.3-9.2C1.5 7.9 3.5 4.7 7 4.5c2-.1 3.9 1 5 2.7 1.1-1.7 3-2.8 5-2.7 3.5.2 5.5 3.4 4.3 6.8-1.7 4.6-9.3 9.2-9.3 9.2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
  {%- when 'planet', 'packaging' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="6.2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M6.3 14.6C3.4 16.4 2 18.1 2.5 19c.8 1.4 5.6-.1 10.8-3.3S22.3 8.4 21.5 7c-.5-.9-2.6-.8-5.5.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M8.2 9.4c1.9.3 4.4 1.4 6.6 3.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  {%- when 'drop', 'shipping' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M12 3c3.6 4.3 6.6 8 6.6 11.4a6.6 6.6 0 1 1-13.2 0C5.4 11 8.4 7.3 12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M9 14.8a3 3 0 0 0 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8L12 3.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M12 3 5 5.8v5.6c0 4.4 3 8 7 9.6 4-1.6 7-5.2 7-9.6V5.8L12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="m8.8 12 2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <circle cx="6.5" cy="17" r="1.8" stroke="currentColor" stroke-width="1.4"/>
      <circle cx="17" cy="17" r="1.8" stroke="currentColor" stroke-width="1.4"/>
    </svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7s-1.5-4-4-3.5C6 4 7 7 12 7zM12 7s1.5-4 4-3.5c2 .5 1 3.5-4 3.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/>
    </svg>
{%- endcase -%}
